        function getDistanceKM(lat1, lon1, lat2, lon2) {
            const R = 6371; 
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon/2) * Math.sin(dLon/2);
            return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        }

        function getFovPolygonPoints(centerLat, centerLng, heading, maxDistKm, fovAngle) {
            const points = [[centerLat, centerLng]];
            const R = 6371; 
            const startAngle = heading - (fovAngle / 2);
            const endAngle = heading + (fovAngle / 2);
            for (let i = startAngle; i <= endAngle; i += 4) {
                const rad = i * Math.PI / 180;
                const distRatio = maxDistKm / R;
                const centerLatRad = centerLat * Math.PI / 180;
                const centerLngRad = centerLng * Math.PI / 180;
                const targetLatRad = Math.asin(Math.sin(centerLatRad) * Math.cos(distRatio) + Math.cos(centerLatRad) * Math.sin(distRatio) * Math.cos(rad));
                const targetLngRad = centerLngRad + Math.atan2(Math.sin(rad) * Math.sin(distRatio) * Math.cos(centerLatRad), Math.cos(distRatio) - Math.sin(centerLatRad) * Math.sin(targetLatRad));
                points.push([targetLatRad * 180 / Math.PI, targetLngRad * 180 / Math.PI]);
            }
            return points;
        }

        function convertGPSToLocalMetres(lat, lon) {
            const latMetres = (lat - BASE_LAT) * 111320;
            const lonMetres = (lon - BASE_LON) * 40075000 * Math.cos(BASE_LAT * Math.PI / 180) / 360;
            return { x: lonMetres, y: latMetres };
        }

        function getPointAtDistanceAndBearing(startLat, startLng, distanceKm, bearingDeg) {
            const angularDistance = distanceKm / 6371;
            const startLatRad = startLat * Math.PI / 180;
            const startLngRad = startLng * Math.PI / 180;
            const bearingRad = bearingDeg * Math.PI / 180;
            const targetLatRad = Math.asin(Math.sin(startLatRad) * Math.cos(angularDistance) + Math.cos(startLatRad) * Math.sin(angularDistance) * Math.cos(bearingRad));
            const targetLngRad = startLngRad + Math.atan2(Math.sin(bearingRad) * Math.sin(angularDistance) * Math.cos(startLatRad), Math.cos(angularDistance) - Math.sin(startLatRad) * Math.sin(targetLatRad));
            return { lat: targetLatRad * 180 / Math.PI, lng: targetLngRad * 180 / Math.PI };
        }

        function getBearing(startLat, startLng, targetLat, targetLng) {
            const startLatRad = startLat * Math.PI / 180;
            const startLngRad = startLng * Math.PI / 180;
            const targetLatRad = targetLat * Math.PI / 180;
            const targetLngRad = targetLng * Math.PI / 180;
            const y = Math.sin(targetLngRad - startLngRad) * Math.cos(targetLatRad);
            const x = Math.cos(startLatRad) * Math.sin(targetLatRad) - Math.sin(startLatRad) * Math.cos(targetLatRad) * Math.cos(targetLngRad - startLngRad);
            return (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;
        }

        function turnDroneTowardHeading(drone, targetHeading, deltaTimeSecs) {
            const normalizedTarget = (targetHeading + 360) % 360;
            const signedDifference = (normalizedTarget - drone.heading + 540) % 360 - 180;
            const maximumTurn = DRONE_TURN_RATE_DEG_PER_SEC * deltaTimeSecs;
            if (Math.abs(signedDifference) <= maximumTurn + 1e-9) {
                drone.heading = normalizedTarget;
                return true;
            }
            drone.heading = (drone.heading + Math.sign(signedDifference) * maximumTurn + 360) % 360;
            return false;
        }

        function resetDroneFlightTrack(drone) {
            if (!drone) return;
            drone.flightTrack = [{ lat: drone.lat, lng: drone.lng }];
        }

        function recordDroneFlightTrack(drone) {
            if (!drone || !Number.isFinite(drone.lat) || !Number.isFinite(drone.lng)) return;
            if (!Array.isArray(drone.flightTrack) || drone.flightTrack.length === 0) {
                resetDroneFlightTrack(drone);
                return;
            }
            const last = drone.flightTrack[drone.flightTrack.length - 1];
            // Store points only after meaningful horizontal movement. This keeps
            // long survey/orbit histories reliable without excessive map load.
            if (getDistanceKM(last.lat, last.lng, drone.lat, drone.lng) >= 0.002) {
                drone.flightTrack.push({ lat: drone.lat, lng: drone.lng });
                if (drone.flightTrack.length > 12000) drone.flightTrack.splice(0, 1000);
            }
        }

        function setupBaseAssets() {
            gcsLayer.clearLayers();
            L.marker([BASE_LAT, BASE_LON], {
