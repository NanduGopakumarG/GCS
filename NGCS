                    renderWaypointPreview();
                });
                return marker;
            });

            const segmentCount = circleSurvey || waypointPlan.length < 2
                ? 0
                : (isClosedPathEditor() ? waypointPlan.length : waypointPlan.length - 1);
            for (let segmentIndex = 0; segmentIndex < segmentCount; segmentIndex++) {
                const startPoint = map.latLngToLayerPoint(waypointPlan[segmentIndex]);
