        function generateSurveyShape() {
            if (!surveyCenter) return;
            const shape = document.getElementById('survey-shape-select').value;
            const circleHelp = document.getElementById('survey-circle-help');
            const regenerateButton = document.getElementById('survey-regenerate-btn');
