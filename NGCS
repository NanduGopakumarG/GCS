            if (!shape) {
                circleHelp.style.display = 'none';
                regenerateButton.innerText = 'Regenerate Shape';
                waypointPlan = [];
                clearWaypointVisuals();
                document.getElementById('path-editor-help').innerText = 'Select a survey shape to create the survey area.';
                return;
            }
            circleHelp.style.display = isCircle ? 'block' : 'none';
            document.getElementById('path-editor-help').innerText = isCircle
                ? 'The circle survey uses interior coverage passes. Resize it only with the white handle on the map.'
                : 'Left-click the map to append a point. Use the + buttons between points to insert one, drag numbered points to reshape the area, or right-click a point to remove it.';
            regenerateButton.innerText = isCustom ? 'Reset Custom Polygon' : 'Regenerate Shape';

            if (surveyCircleRadiusHandle) {
                map.removeLayer(surveyCircleRadiusHandle);
                surveyCircleRadiusHandle = null;
            }
