            }).addTo(map);
            orbitCenterHandle.on('drag', function(e) {
                const position = e.target.getLatLng();
                contextMenuTarget = L.latLng(position.lat, position.lng);
                orbitVisualCircle.setLatLng(contextMenuTarget);
                const currentRadius = Math.max(0.1, parseFloat(document.getElementById('mission-orbit-radius').value) || radiusKm || 1);
                const edgePosition = getPointAtDistanceAndBearing(position.lat, position.lng, currentRadius, 90);
                orbitDragHandle.setLatLng([edgePosition.lat, edgePosition.lng]);
