            // In ADR mode, a single deployed drone must become a valid one-node cluster so the ADR can focus its FOV on it.
            // Fly mode keeps the original two-node DBSCAN requirement unless swarm mode is enabled separately.
            const minimumClusterSize = isFlyMode ? 2 : 1;
            runDBSCANClustering(dronesData, INTER_DRONE_RANGE_KM * 1000, minimumClusterSize);
        }

