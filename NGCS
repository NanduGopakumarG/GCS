                                    ? `${drone.mission.phase.toUpperCase()} · ${drone.mission.type.toUpperCase()}${getMissionQueueLabel(drone)}`
                                    : drone.mission?.active
                                        ? `${drone.mission.type.toUpperCase()} ACTIVE${getMissionQueueLabel(drone)}`
                                        : drone.mission?.paused
                                            ? `${drone.mission.type.toUpperCase()} PAUSED${getMissionQueueLabel(drone)}`
                                            : drone.mission?.completed
                                                ? `${drone.mission.type.toUpperCase()} COMPLETE`
                                                : 'NONE';

                    droneContainer.innerHTML = `
                        <div class="data-section-title" style="color:#5dade2;">SWARM DRONE TELEMETRY</div>
                        <div class="data-row"><span>Drone ID:</span><b style="color:#fff;">${drone.id}</b></div>
                        <div class="data-row"><span>Latitude:</span><b style="color:#fff;">${drone.lat.toFixed(6)}°</b></div>
                        <div class="data-row"><span>Longitude:</span><b style="color:#fff;">${drone.lng.toFixed(6)}°</b></div>
                        <div class="data-row"><span>Altitude:</span><b style="color:#fff;">${drone.altitude.toFixed(1)} m</b></div>
                        <div class="data-row"><span>Velocity:</span><b style="color:#fff;">${drone.velocity.toFixed(1)} m/s</b></div>
                        <div class="data-row"><span>Heading:</span><b style="color:#fff;">${drone.heading.toFixed(1)}°</b></div>
                        <div class="data-row"><span>Armed:</span><b style="color:${drone.armed ? '#2ecc71' : '#e74c3c'};">${drone.armed ? 'YES' : 'NO'}</b></div>
                        <div class="data-row"><span>Flight State:</span><b style="color:#5dade2;">${flightState}</b></div>
                        ${drone.airframe === 'vtol' ? `
                        <div class="data-row"><span>VTOL Mode:</span><b style="color:#d2b4de;">${drone.vtolMode}</b></div>
                        <div class="data-row"><span>VTOL Config:</span><b style="color:#d2b4de;">${drone.vtolConfig}</b></div>
                        <div class="data-row"><span>Airspeed:</span><b style="color:#d2b4de;">${(drone.currentAirspeed || 0).toFixed(1)} m/s</b></div>
                        <div class="data-row"><span>Min Airspeed:</span><b style="color:#d2b4de;">${drone.vtolMinAirspeed} m/s</b></div>
                        ` : ''}
                        <div class="data-row"><span>Mission State:</span><b style="color:#f1c40f;">${missionState}</b></div>
                        <div class="data-row"><span>Home Latitude:</span><b style="color:#fff;">${homeLat.toFixed(6)}°</b></div>
                        <div class="data-row"><span>Home Longitude:</span><b style="color:#fff;">${homeLng.toFixed(6)}°</b></div>
                        <div class="data-row"><span>Launch Latitude:</span><b style="color:#fff;">${launchLat.toFixed(6)}°</b></div>
                        <div class="data-row"><span>Launch Longitude:</span><b style="color:#fff;">${launchLng.toFixed(6)}°</b></div>
                        <div class="data-row"><span>Distance Home:</span><b style="color:#fff;">${distanceHome.toFixed(2)} km</b></div>
                        <div class="data-row"><span>Distance Launch:</span><b style="color:#fff;">${distanceLaunch.toFixed(2)} km</b></div>
                        <div class="data-row"><span>Distance to GCS:</span><b style="color:#fff;">${distanceBase.toFixed(2)} km</b></div>
                        <div class="data-row"><span>Signal RSSI:</span><b style="color:${rssiColor};">${rssi.toFixed(1)} dBm</b></div>
                        <div class="data-row"><span>Network:</span><b style="color:${clusterColor};">${clusterText}</b></div>
                        <div style="margin-top:8px; padding-top:6px; border-top:1px solid #444; color:#777; font-size:10px; text-align:right;">LIVE · ${new Date().toLocaleTimeString()}</div>
                    `;
                }
            }

            const adrContainer = document.getElementById('adr-telemetry-data');
            if (!adrContainer) return;
            adrContainer.innerHTML = '';
            
            if (adrFleet.length === 0) {
                adrContainer.innerHTML = '<i style="color:#aaa; font-size: 0.85em;">No ADR Birds Deployed.</i>';
            } else {
                adrFleet.forEach(adr => {
                    const distGCS = getDistanceKM(adr.lat, adr.lng, BASE_LAT, BASE_LON);
                    const rssiColor = adr.rssi_dbm < CRITICAL_RSSI_THRESHOLD ? '#ff5555' : '#2ecc71';
                    adrContainer.innerHTML += `
                        <div class="adr-card">
                            <div class="data-row"><span>ID:</span> <b style="color:#e74c3c">${adr.id}</b></div>
                            <div class="data-row"><span>Latitude:</span> <b style="color:#fff;">${adr.lat.toFixed(5)}°</b></div>
                            <div class="data-row"><span>Longitude:</span> <b style="color:#fff;">${adr.lng.toFixed(5)}°</b></div>
                            <div class="data-row"><span>Altitude:</span> <b style="color:#fff;">${adr.altitude.toFixed(1)} m</b></div>
                            <div class="data-row"><span>Velocity:</span> <b style="color:#fff;">${adr.velocity.toFixed(1)} m/s</b></div>
                            <div class="data-row"><span>Antenna Yaw:</span> <b style="color:#fff;">${adr.heading.toFixed(1)}°</b></div>
                            <div class="data-row"><span>Dist to GCS:</span> <b style="color:${distGCS <= GCS_RANGE_LIMIT_KM + 1e-9 ? '#2ecc71' : '#ff5555'};">${distGCS.toFixed(2)} / ${GCS_RANGE_LIMIT_KM.toFixed(0)} km</b></div>
                            <div class="data-row"><span>Signal RSSI:</span> <b style="color:${rssiColor}">${adr.rssi_dbm.toFixed(1)} dBm</b></div>
                            <div class="data-row"><span>ADR State:</span> <b style="color:#f1c40f;">${adr.state || 'STANDBY'}</b></div>
                            <div class="data-row"><span>Target Clusters:</span> <b style="color:#fff;">${adr.activeTargets && adr.activeTargets.length ? adr.activeTargets.join(', ') : 'None'}</b></div>
                            <div class="data-row"><span>Qualified Clusters:</span> <b style="color:#2ecc71;">${adr.supportedClusters || 0}</b></div>
                            <div class="data-row"><span>Cluster Rule:</span> <b style="color:#fff;">≥ ${MIN_CLUSTER_NODES_IN_FOV} drones in FOV</b></div>
                            <div class="data-row"><span>FOV Shared:</span> <b style="color:${(adr.fovOverlapRatio || 0) <= MAX_ADR_FOV_OVERLAP_RATIO ? '#2ecc71' : '#ff5555'};">${(adr.fovOverlapPercent || 0).toFixed(1)}%</b></div>
                            <div class="data-row"><span>FOV Share Limit:</span> <b style="color:#fff;">0-10%</b></div>
                            <div class="data-row"><span>Supported Nodes:</span> <b style="color:#fff;">${adr.supportedNodes || 0}</b></div>
                        </div>
                    `;
                });
            }
        }

        document.getElementById('drone-select-dropdown').addEventListener('change', function(e) {
            selectedTelemetryDroneId = e.target.value;
            updateTelemetryPanel();
        });

        const adrCountInput = document.getElementById('adr-count-select');
        let adrCountUpdateTimer = null;
        adrCountInput.addEventListener('input', () => {
            clearTimeout(adrCountUpdateTimer);
            adrCountUpdateTimer = setTimeout(() => {
                setupBaseAssets();
                computeAndRenderAirspace();
            }, 250);
        });
        adrCountInput.addEventListener('change', () => {
            clearTimeout(adrCountUpdateTimer);
            setupBaseAssets();
            computeAndRenderAirspace();
        });

        document.getElementById('update-btn').addEventListener('click', generateSwarmArray);
        document.getElementById('launch-swarm-btn').addEventListener('click', launchSwarmNearGcs);

        // Unified airframe selector handler for both ADR and Fly modes
        function handleAirframeChange(airframeType) {
            selectedAirframeType = airframeType;
            
            // Sync both sidebar and fly control selectors
            const sidebarSelector = document.getElementById('airframe-select');
            const flySelector = document.getElementById('fly-airframe-select');
            if (sidebarSelector) sidebarSelector.value = airframeType;
            if (flySelector) flySelector.value = airframeType;
            
            console.log(`[AIRFRAME] Changed to: ${airframeType} (Mode: ${isFlyMode ? 'FLY' : 'ADR'})`);
            
            // Show/hide VTOL config section in sidebar (ADR mode)
            const vtolConfigSection = document.getElementById('vtol-config-section');
            if (vtolConfigSection) {
                vtolConfigSection.style.display = airframeType === 'vtol' ? 'block' : 'none';
            }
            
            // Show/hide VTOL config section in FLY mode control
            const flyVtolConfigSection = document.getElementById('fly-vtol-config-section');
            if (flyVtolConfigSection) {
                flyVtolConfigSection.style.display = airframeType === 'vtol' ? 'block' : 'none';
            }
            
            // Show/hide Fixed-Wing config section in sidebar
            const fixedWingConfigSection = document.getElementById('fixed-wing-config-section');
            if (fixedWingConfigSection) {
                fixedWingConfigSection.style.display = airframeType === 'fixed-wing' ? 'block' : 'none';
            }
            
            // Regenerate drones based on current mode
            if (isFlyMode) {
                applyFlyFleetSize();
            } else {
                generateSwarmArray();
            }
        }
        
        // VTOL Mode Configuration Handler
        function handleVtolModeChange(modeConfig) {
            // Update both sidebar and FLY mode info sections
            const infoElement = document.getElementById('vtol-mode-info');
            const flyInfoElement = document.getElementById('fly-vtol-mode-info');
            
            const infoText = modeConfig === 'MR-FW' 
                ? 'MR→FW: Vertical takeoff enabled. Transitions to fixed-wing flight at minimum airspeed. Fixed-wing landing only (no vertical descent).'
                : 'FW→MR: Full vertical takeoff/landing capability. Can transition between vertical (MR) and horizontal (FW) flight modes freely. Uses vertical landing.';
            
            if (infoElement) infoElement.innerText = infoText;
            if (flyInfoElement) flyInfoElement.innerText = infoText;
            
            // Sync VTOL mode selectors between sidebar and FLY mode
            const sidebarModeSelect = document.getElementById('vtol-mode-select');
            const flyModeSelect = document.getElementById('fly-vtol-mode-select');
            if (sidebarModeSelect) sidebarModeSelect.value = modeConfig;
            if (flyModeSelect) flyModeSelect.value = modeConfig;
            
            console.log(`[VTOL] Mode changed to: ${modeConfig}`);
            updateVtolConfigForAllDrones();
        }
        
        function updateVtolConfigForAllDrones() {
            // Use sidebar or FLY mode VTOL config, whichever is visible
            let modeSelect = document.getElementById('vtol-mode-select');
            let airspeedInput = document.getElementById('vtol-min-airspeed');
            
            // If in FLY mode, prefer FLY mode controls
            if (isFlyMode) {
                const flyModeSelect = document.getElementById('fly-vtol-mode-select');
                const flyAirspeedInput = document.getElementById('fly-vtol-min-airspeed');
                if (flyModeSelect) modeSelect = flyModeSelect;
                if (flyAirspeedInput) airspeedInput = flyAirspeedInput;
            }
            
            if (!modeSelect || !airspeedInput) return;
            
            const vtolConfig = modeSelect.value;
            const minAirspeed = parseFloat(airspeedInput.value) || 15;
            
            // Sync values between sidebar and FLY mode controls
            const sidebarModeSelect = document.getElementById('vtol-mode-select');
            const flyModeSelect = document.getElementById('fly-vtol-mode-select');
            const sidebarAirspeedInput = document.getElementById('vtol-min-airspeed');
            const flyAirspeedInput = document.getElementById('fly-vtol-min-airspeed');
            
            if (sidebarModeSelect && flyModeSelect) {
                sidebarModeSelect.value = vtolConfig;
                flyModeSelect.value = vtolConfig;
            }
            if (sidebarAirspeedInput && flyAirspeedInput) {
                sidebarAirspeedInput.value = minAirspeed;
                flyAirspeedInput.value = minAirspeed;
            }
            
            // Update all drones with VTOL configuration
            dronesData.forEach(drone => {
                if (drone.airframe === 'vtol') {
                    drone.vtolConfig = vtolConfig;
                    drone.vtolMinAirspeed = minAirspeed;
                    drone.vtolMode = 'MR'; // Start in multirotor mode
                    drone.currentAirspeed = 0;
                }
            });
            
            console.log(`[VTOL] Updated all drones: config=${vtolConfig}, minAirspeed=${minAirspeed}m/s`);
        }
        
        // VTOL Flight Mechanics - Handle airspeed changes and mode transitions
        function updateVtolFlightDynamics(drone, deltaTimeSec) {
            if (drone.airframe !== 'vtol') return;
            
            const minAirspeed = drone.vtolMinAirspeed || 15;
            const isMoving = drone.velocity > 0.5;
            
            // Simulate airspeed buildup when moving (in FW mode or during climb)
            if (isMoving && drone.vtolMode === 'MR') {
                // In MR mode, accelerate gradually toward FW mode transition
                drone.currentAirspeed = Math.min(drone.currentAirspeed + (drone.velocity * 0.3), drone.velocity);
            } else if (drone.vtolMode === 'FW') {
                // In FW mode, maintain velocity as airspeed
                drone.currentAirspeed = drone.velocity;
            } else {
                // Stationary or hovering - no airspeed
                drone.currentAirspeed = Math.max(0, drone.currentAirspeed - (deltaTimeSec * 2));
            }
            
            // Check for MR → FW mode transition
            if (drone.vtolMode === 'MR' && drone.currentAirspeed >= minAirspeed) {
                if (drone.vtolConfig === 'MR-FW' || drone.vtolConfig === 'FW-MR') {
                    drone.vtolMode = 'FW';
                    console.log(`[VTOL] ${drone.id}: Transitioned MR → FW at ${drone.currentAirspeed.toFixed(1)} m/s`);
                }
            }
            
            // Check for FW → MR mode transition (only in FW-MR config)
            if (drone.vtolMode === 'FW' && drone.vtolConfig === 'FW-MR' && drone.currentAirspeed < (minAirspeed * 0.7)) {
                drone.vtolMode = 'MR';
                console.log(`[VTOL] ${drone.id}: Transitioned FW → MR at ${drone.currentAirspeed.toFixed(1)} m/s`);
            }
        }
        
        // VTOL Takeoff Handler
        function vtolTakeoff(drone) {
            if (drone.airframe !== 'vtol') return false;
            
            const config = drone.vtolConfig || 'MR-FW';
            
            if (config === 'MR-FW') {
                // MR-FW: Always vertical takeoff
                drone.altitude += 2; // Climb 2m per tick
                drone.velocity = 1; // Low speed during climb
                drone.vtolMode = 'MR';
                return true;
            } else if (config === 'FW-MR') {
                // FW-MR: Can do vertical OR forward takeoff
                // For now, simulate vertical takeoff
                drone.altitude += 2;
                drone.velocity = 1;
                drone.vtolMode = 'MR';
                return true;
            }
            return false;
        }
        
        // VTOL Landing Handler
        function vtolLanding(drone, targetAltitude = 0) {
            if (drone.airframe !== 'vtol') return false;
            
            const config = drone.vtolConfig || 'MR-FW';
            const descendRate = 2; // 2m per tick
            
            if (config === 'MR-FW') {
                // MR-FW: Fixed-wing landing (diagonal descent)
                // Must be in forward flight, descend while maintaining speed
                if (drone.velocity > drone.vtolMinAirspeed * 0.5) {
                    drone.altitude = Math.max(targetAltitude, drone.altitude - descendRate * 0.7);
                    drone.velocity *= 0.98; // Gradual deceleration
                    return drone.altitude > targetAltitude;
                }
                return false;
            } else if (config === 'FW-MR') {
                // FW-MR: Vertical landing (transition to MR mode)
                if (drone.vtolMode === 'FW') {
                    // First transition to MR mode for vertical descent
                    drone.vtolMode = 'MR';
                    drone.currentAirspeed = 0;
                    drone.velocity *= 0.95; // Decelerate
                }
                // Vertical descent in MR mode
                drone.altitude = Math.max(targetAltitude, drone.altitude - descendRate);
                drone.velocity *= 0.95; // Decelerate to zero
                return drone.altitude > targetAltitude;
            }
            return false;
        }
        
        // Fixed-Wing Takeoff Handler
        function fixedWingTakeoff(drone) {
            if (drone.airframe !== 'fixed-wing') return false;
            
            const targetAirspeed = drone.fixedWingTakeoffAirspeed || 20;
            const accelerationRate = 1.5; // m/s per tick
            
            // Accelerate along runway (horizontal)
            drone.velocity = Math.min(drone.velocity + accelerationRate, targetAirspeed);
            drone.currentAirspeed = drone.velocity;
            
            // Once minimum airspeed is reached, begin climbing
            if (drone.velocity >= targetAirspeed * 0.95) {
                // Climb while maintaining airspeed
                drone.altitude += 1.5; // Climb 1.5m per tick
                console.log(`[FIXED-WING] ${drone.id}: Climbing at ${drone.velocity.toFixed(1)} m/s, alt=${drone.altitude.toFixed(1)}m`);
                return true; // Still taking off (climbing)
            }
            
            console.log(`[FIXED-WING] ${drone.id}: Accelerating on runway - airspeed=${drone.velocity.toFixed(1)} m/s`);
            return true; // Still taking off (accelerating)
        }
        
        // Fixed-Wing Landing Handler
        function fixedWingLanding(drone, targetAltitude = 0) {
            if (drone.airframe !== 'fixed-wing') return false;
            
            const landingDistance = drone.fixedWingLandingDistance || 0.5; // km
            const descendRate = 1.2; // m per tick (shallow angle)
            const decelerationRate = 0.8; // m/s per tick
            
            // Maintain minimum airspeed during descent
            const minAirspeed = drone.fixedWingTakeoffAirspeed * 0.8 || 16;
            drone.velocity = Math.max(minAirspeed, drone.velocity - decelerationRate);
            drone.currentAirspeed = drone.velocity;
            
            // Shallow descent while maintaining forward speed
            drone.altitude = Math.max(targetAltitude, drone.altitude - descendRate);
            
            // Touchdown when altitude reaches target
            if (drone.altitude <= targetAltitude + 0.1) {
                drone.altitude = targetAltitude;
                drone.velocity = 0;
                drone.currentAirspeed = 0;
                console.log(`[FIXED-WING] ${drone.id}: Landed successfully`);
                return false; // Landing complete
            }
            
            console.log(`[FIXED-WING] ${drone.id}: Descending at ${drone.velocity.toFixed(1)} m/s, alt=${drone.altitude.toFixed(1)}m`);
            return true; // Still landing (descending)
        }
        
        // Update Fixed-Wing Configuration for All Drones
        function updateFixedWingConfigForAllDrones() {
            const takeoffAirspeedInput = document.getElementById('fixed-wing-takeoff-airspeed');
            const cruiseSpeedInput = document.getElementById('fixed-wing-cruise-speed');
            const landingDistanceInput = document.getElementById('fixed-wing-landing-distance');
            
            if (!takeoffAirspeedInput || !cruiseSpeedInput || !landingDistanceInput) return;
            
            const takeoffAirspeed = parseFloat(takeoffAirspeedInput.value) || 20;
            const cruiseSpeed = parseFloat(cruiseSpeedInput.value) || 25;
            const landingDistance = parseFloat(landingDistanceInput.value) || 0.5;
            
            // Update all fixed-wing drones
            dronesData.forEach(drone => {
                if (drone.airframe === 'fixed-wing') {
                    drone.fixedWingTakeoffAirspeed = takeoffAirspeed;
                    drone.fixedWingCruiseSpeed = cruiseSpeed;
                    drone.fixedWingLandingDistance = landingDistance;
                    drone.currentAirspeed = 0;
                }
            });
            
            console.log(`[FIXED-WING] Updated all drones: takeoff=${takeoffAirspeed}m/s, cruise=${cruiseSpeed}m/s, landing=${landingDistance}km`);
        }
        
        // Attach event listener to sidebar airframe selector
        const sidebarAirframeSelector = document.getElementById('airframe-select');
        if (sidebarAirframeSelector) {
            sidebarAirframeSelector.addEventListener('change', (e) => {
                handleAirframeChange(e.target.value);
            });
        }
        
        // Attach VTOL mode selector event listener
        const vtolModeSelect = document.getElementById('vtol-mode-select');
        if (vtolModeSelect) {
            vtolModeSelect.addEventListener('change', (e) => {
                handleVtolModeChange(e.target.value);
            });
        }
        
        // Attach VTOL minimum airspeed input listener
        const vtolMinAirspeedInput = document.getElementById('vtol-min-airspeed');
        if (vtolMinAirspeedInput) {
            vtolMinAirspeedInput.addEventListener('change', () => {
                updateVtolConfigForAllDrones();
            });
        }

        // Attach Fixed-Wing configuration input listeners
        const fixedWingTakeoffAirspeedInput = document.getElementById('fixed-wing-takeoff-airspeed');
        const fixedWingCruiseSpeedInput = document.getElementById('fixed-wing-cruise-speed');
        const fixedWingLandingDistanceInput = document.getElementById('fixed-wing-landing-distance');
        
        const attachFixedWingListeners = () => {
            if (fixedWingTakeoffAirspeedInput) {
                fixedWingTakeoffAirspeedInput.addEventListener('change', updateFixedWingConfigForAllDrones);
            }
            if (fixedWingCruiseSpeedInput) {
                fixedWingCruiseSpeedInput.addEventListener('change', updateFixedWingConfigForAllDrones);
            }
            if (fixedWingLandingDistanceInput) {
                fixedWingLandingDistanceInput.addEventListener('change', updateFixedWingConfigForAllDrones);
            }
        };
        attachFixedWingListeners();

        // --- MAP LEGEND ---
        let legendContainer = null;

        function updateSystemMapLegend(force = false) {
            const now = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
            if (!force && now - lastLegendUpdateAt < LEGEND_UPDATE_INTERVAL_MS) {
                return;
            }
            lastLegendUpdateAt = now;

            if (!legendContainer) return;

            const clusterIds = [...new Set(dronesData.map(d => d.cluster))]
                .filter(c => c !== -1)
                .sort((a, b) => a - b);

            let legendHtml = `<b style="color:#fff; display:block; margin-bottom:6px;">${isFlyMode ? 'Fly Map Index' : 'System Map Index'}</b>`;
            if (isFlyMode) {
                legendHtml += `<div style="margin-bottom:6px;"><div class="legend-icon">${getDroneSvg('#3498db', 18)}</div> Simulated Drone Fleet (${dronesData.length})</div>`;
            } else {
                legendHtml += `<div style="margin-bottom:6px;"><div class="legend-icon">${getAntennaSvg('#2ecc71', 18)}</div> GCS Transmission Station</div>`;
                legendHtml += `<div style="margin-bottom:6px;"><div class="legend-icon"><div style="width:14px; height:2px; background:#90ee90; opacity:0.6; border-radius:0%;"></div></div> GCS 10km Coverage Ring</div>`;
                legendHtml += `<div style="margin-bottom:6px;"><div class="legend-icon">${getDroneSvg('#e74c3c', 18)}</div> ADR Airborne Fleet Unit (Large)</div>`;
            }
            legendHtml += `<div style="margin-bottom:6px;"><div class="legend-icon"><div style="width:14px; height:3px; background:#1abc9c;"></div></div> Active Waypoint Route</div>`;
            legendHtml += `<div style="margin-bottom:6px;"><div class="legend-icon"><div style="width:14px; height:3px; background:#9b59b6;"></div></div> Active Survey Route</div>`;

            if (!isFlyMode && clusterIds.length > 0) {
                legendHtml += '<div style="margin-top:8px; padding-top:6px; border-top:1px solid #444;"><b style="color:#fff; display:block; margin-bottom:6px;">Formed Clusters</b>';
                clusterIds.forEach(cId => {
                    const color = clusterColors[cId] || '#1abc9c';
                    const members = dronesData.filter(d => d.cluster === cId).length;
                    legendHtml += `<div style="margin-bottom:6px; display:flex; align-items:center; gap:6px;"><span>${getDroneSvg(color, 14)}</span> Cluster ${cId} (${members} units)</div>`;
                });
                legendHtml += '</div>';
            } else if (!isFlyMode) {
                legendHtml += '<div style="margin-top:8px; color:#aaa; font-style:italic;">No clusters formed yet</div>';
            }

            legendContainer.innerHTML = legendHtml;
        }

        const legend = L.control({position: 'bottomright'});
        legend.onAdd = function () {
            const div = L.DomUtil.create('div', 'legend');
            legendContainer = div;
            updateSystemMapLegend();
            return div;
        };
        legend.addTo(map);

        setupBaseAssets();
        setFlightMode(true);
        applyFlyFleetSize();
    </script>
