        function splitSurveyWaypointsForDrone(waypoints, droneIndex, droneCount) {
            if (!Array.isArray(waypoints) || waypoints.length < 2 || droneCount <= 1) {
                return (waypoints || []).map(point => ({ ...point }));
            }
            const segmentCount = waypoints.length - 1;
            const startSegment = Math.floor((droneIndex * segmentCount) / droneCount);
            const endSegment = Math.max(startSegment + 1, Math.floor(((droneIndex + 1) * segmentCount) / droneCount));
            const startIndex = Math.min(startSegment, waypoints.length - 2);
            const endIndex = Math.min(endSegment, waypoints.length - 1);
            const section = waypoints.slice(startIndex, endIndex + 1).map(point => ({ ...point }));
            return section.length >= 2 ? section : waypoints.slice(-2).map(point => ({ ...point }));
        }

