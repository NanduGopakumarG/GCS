        function getNearestWaypointSegmentIndex(latlng) {
            if (waypointPlan.length < 2) return waypointPlan.length - 1;
            const clickPoint = map.latLngToLayerPoint(latlng);
            let nearestIndex = 0;
            let nearestDistanceSquared = Infinity;
            const segmentCount = isClosedPathEditor() ? waypointPlan.length : waypointPlan.length - 1;

            for (let i = 0; i < segmentCount; i++) {
                const start = map.latLngToLayerPoint(waypointPlan[i]);
                const end = map.latLngToLayerPoint(waypointPlan[(i + 1) % waypointPlan.length]);
                const deltaX = end.x - start.x;
                const deltaY = end.y - start.y;
                const segmentLengthSquared = deltaX * deltaX + deltaY * deltaY;
                const projection = segmentLengthSquared
                    ? Math.max(0, Math.min(1,
                        ((clickPoint.x - start.x) * deltaX + (clickPoint.y - start.y) * deltaY) /
                        segmentLengthSquared
                    ))
                    : 0;
                const closestX = start.x + projection * deltaX;
                const closestY = start.y + projection * deltaY;
                const distanceSquared =
                    (clickPoint.x - closestX) * (clickPoint.x - closestX) +
                    (clickPoint.y - closestY) * (clickPoint.y - closestY);
                if (distanceSquared < nearestDistanceSquared) {
                    nearestDistanceSquared = distanceSquared;
                    nearestIndex = i;
                }
            }
            return nearestIndex;
        }

        function convertLocalKmToGps(xKm, yKm) {
            return {
                lat: BASE_LAT + yKm / 111.320,
                lng: BASE_LON + xKm / (111.320 * Math.cos(BASE_LAT * Math.PI / 180))
            };
        }

        function buildSurveyCoveragePath(boundaryPoints, spacingKm) {
            if (!Array.isArray(boundaryPoints) || boundaryPoints.length < 3) return [];
            const polygon = boundaryPoints.map(point => getLocalKm(point.lat, point.lng));
            const minY = Math.min(...polygon.map(point => point.y));
            const maxY = Math.max(...polygon.map(point => point.y));
            const safeSpacingKm = Math.max(0.05, spacingKm || 0.5);
            const scanRows = [];

            for (let y = minY + safeSpacingKm / 2; y < maxY; y += safeSpacingKm) {
                scanRows.push(y);
            }
            if (scanRows.length === 0) scanRows.push((minY + maxY) / 2);

            const route = [];
            let reverseNextSegment = false;
            scanRows.forEach(y => {
                const intersections = [];
                for (let index = 0; index < polygon.length; index++) {
                    const start = polygon[index];
                    const end = polygon[(index + 1) % polygon.length];
                    const crossesScanLine =
                        (start.y <= y && end.y > y) ||
                        (end.y <= y && start.y > y);
                    if (!crossesScanLine) continue;
                    const ratio = (y - start.y) / (end.y - start.y);
                    intersections.push(start.x + ratio * (end.x - start.x));
                }
                intersections.sort((a, b) => a - b);
                for (let index = 0; index + 1 < intersections.length; index += 2) {
                    const left = convertLocalKmToGps(intersections[index], y);
                    const right = convertLocalKmToGps(intersections[index + 1], y);
                    if (reverseNextSegment) route.push(right, left);
                    else route.push(left, right);
                    reverseNextSegment = !reverseNextSegment;
                }
            });
            return route;
        }

