        function computeAndRenderAirspace() {
            drawStaticNetworkVisuals(true);

            dronesData.forEach(drone => {
                const customIcon = createDroneMarkerIcon(drone);

                if (droneMarkers[drone.id]) {
                    droneMarkers[drone.id].setLatLng([drone.lat, drone.lng]);
                    droneMarkers[drone.id].setIcon(customIcon);
                } else {
                    const marker = L.marker([drone.lat, drone.lng], { icon: customIcon, draggable: true }).addTo(droneLayer);
                    droneMarkers[drone.id] = marker;

                    marker.on('click', function(e) {
                        if (isGcsSelectionMode) return;
                        selectedDrones.clear();
                        selectedDrones.add(drone.id);
                        updateSelectionVisuals();
                        const drp = document.getElementById('drone-select-dropdown');
                        if(drp) drp.value = drone.id;
                        selectedTelemetryDroneId = drone.id;
                        if (isFlyMode) {
                            selectedFlyTelemetryDroneId = drone.id;
                            const flyDropdown = document.getElementById('fly-telemetry-drone-select');
                            if (flyDropdown) flyDropdown.value = drone.id;
                            updateFlyTelemetryPanel(true);
                        }
                        updateTelemetryPanel();
                    });

                    marker.on('contextmenu', function(e) {
                        if (isPathPlanningMode || isGcsSelectionMode || editingMissionRoleCard) return;
                        
                        // Stop normal map context menu
                        L.DomEvent.stopPropagation(e);
                        
                        // If drone is in a mission, show mission reassignment menu
                        if (isDroneMissionBusy(drone)) {
                            showDroneMissionContextMenu(e, drone);
                        } else {
                            // Otherwise show normal context menu at map location
                            contextMenuTarget = e.latlng;
                            const menu = document.getElementById('map-context-menu');
                            menu.style.display = 'block';
                            menu.style.left = e.containerPoint.x + 'px';
                            menu.style.top = e.containerPoint.y + 'px';
                        }
                    });

                    marker.on('dragstart', function(e) {
                        if (isGcsSelectionMode) return;
                        if (!selectedDrones.has(drone.id)) {
                            selectedDrones.clear();
                            selectedDrones.add(drone.id);
                            updateSelectionVisuals();
                            const drp = document.getElementById('drone-select-dropdown');
                            if(drp) drp.value = drone.id;
                            selectedTelemetryDroneId = drone.id;
                            if (isFlyMode) {
                                selectedFlyTelemetryDroneId = drone.id;
                                const flyDropdown = document.getElementById('fly-telemetry-drone-select');
                                if (flyDropdown) flyDropdown.value = drone.id;
                                updateFlyTelemetryPanel(true);
                            }
                        }
                        
                        dragStartPositions = {};
                        selectedDrones.forEach(id => {
                            let d = droneById.get(id);
                            if (d) {
                                dragStartPositions[id] = { lat: d.lat, lng: d.lng };
                                if (d.mission) d.mission.active = false; 
                            }
                        });
                        this._dragStartCenter = e.target.getLatLng();
                    });

                    marker.on('drag', function(e) {
                        if (isGcsSelectionMode) return;
                        const currentPos = e.target.getLatLng();
                        const deltaLat = currentPos.lat - this._dragStartCenter.lat;
                        const deltaLng = currentPos.lng - this._dragStartCenter.lng;

                        selectedDrones.forEach(id => {
                            let d = droneById.get(id);
                            if (d) {
                                if (id === drone.id) {
                                    d.lat = currentPos.lat;
                                    d.lng = currentPos.lng;
                                } else {
                                    let orig = dragStartPositions[id];
                                    if (orig) {
                                        d.lat = orig.lat + deltaLat;
                                        d.lng = orig.lng + deltaLng;
                                    }
                                }
                            }
                        });
                        scheduleDragMarkerUpdate();
                    });

                    marker.on('dragend', function() {
                        if (dragUpdateFrame) {
                            cancelAnimationFrame(dragUpdateFrame);
                            dragUpdateFrame = null;
                            dragMarkerUpdateRequested = false;
                        }
                        computeAndRenderAirspace();
                    });
                }
            });

            Object.keys(droneMarkers).forEach(id => {
                if (!droneById.has(id)) {
                    droneLayer.removeLayer(droneMarkers[id]);
                    delete droneMarkers[id];
                }
            });
        }

        function drawStaticNetworkVisuals(force = false) {
            const now = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
            if (!force && now - lastVisualRenderAt < VISUAL_RENDER_INTERVAL_MS) {
                return;
            }
            lastVisualRenderAt = now;

            const shouldOptimizeAdr = force || now - lastAdrOptimizationAt >= ADR_OPTIMIZATION_INTERVAL_MS;
            if (!shouldOptimizeAdr) {
                return;
            }
            lastAdrOptimizationAt = now;

            processCoreDroneData();
            adrLayer.clearLayers();
            adrMarkers.clear();
            adrFovPolygons.clear();
            adrHeadingLines.clear();
            missionLayer.clearLayers();
            const activeMeshKeys = new Set();

            // Track active orbit rings to avoid repeating overlapping circles
            const plottedOrbits = new Set();
            const plottedWaypointPaths = new Set();
            const plottedSurveyAreas = new Set();

            for (let i = 0; i < dronesData.length; i++) {
                const flightTrack = Array.isArray(dronesData[i].flightTrack) ? dronesData[i].flightTrack : [];
                if (flightTrack.length > 1) {
                    L.polyline(flightTrack, {
                        color: '#ff2d2d', weight: 3.5, opacity: 0.92,
                        interactive: false, renderer: overlayRenderer
                    }).bindTooltip(`${dronesData[i].id} flown path`, { sticky: true }).addTo(missionLayer);
                }
                if (dronesData[i].rtlAction) {
                    L.polyline([
                        [dronesData[i].lat, dronesData[i].lng],
                        [dronesData[i].rtlAction.launchLat, dronesData[i].rtlAction.launchLng]
                    ], {
                        color: '#bb8fce', weight: 3, dashArray: '7, 5', opacity: 0.9,
                        interactive: false, renderer: overlayRenderer
                    }).addTo(missionLayer);
                }
                if (dronesData[i].rthAction) {
                    L.polyline([
                        [dronesData[i].lat, dronesData[i].lng],
                        [dronesData[i].rthAction.homeLat, dronesData[i].rthAction.homeLng]
                    ], {
                        color: '#5dade2', weight: 3, dashArray: '7, 5', opacity: 0.9,
                        interactive: false, renderer: overlayRenderer
                    }).addTo(missionLayer);
                }
                if (dronesData[i].mission && dronesData[i].mission.active) {
                    if (dronesData[i].mission.type === 'waypoint' || dronesData[i].mission.type === 'survey') {
                        const routeColor = dronesData[i].mission.type === 'survey' ? '#9b59b6' : '#1abc9c';
                        if (dronesData[i].mission.type === 'survey' && dronesData[i].mission.surveyBoundary) {
                            const areaKey = dronesData[i].mission.surveyBoundary.map(point =>
                                `${point.lat.toFixed(6)},${point.lng.toFixed(6)}`
                            ).join('|');
                            if (!plottedSurveyAreas.has(areaKey)) {
                                L.polygon(dronesData[i].mission.surveyBoundary, {
                                    color: '#9b59b6',
                                    weight: 2,
                                    fillColor: '#9b59b6',
                                    fillOpacity: 0.08,
                                    interactive: false,
                                    renderer: overlayRenderer
                                }).addTo(missionLayer);
                                plottedSurveyAreas.add(areaKey);
                            }
                        }
                        const waypointIndex = dronesData[i].mission.waypointIndex || 0;
                        const remainingWaypoints = (dronesData[i].mission.waypoints || []).slice(waypointIndex);
                        const nextWaypoint = remainingWaypoints[0];
                        if (nextWaypoint) {
                            // Only this approach segment differs per drone. The remaining
                            // waypoint path is shared and rendered once for the whole group.
                            L.polyline([
                                [dronesData[i].lat, dronesData[i].lng],
                                [nextWaypoint.lat, nextWaypoint.lng]
                            ], {
                                color: routeColor, weight: 2, dashArray: '4, 5', opacity: 0.75,
                                interactive: false, renderer: overlayRenderer
                            }).addTo(missionLayer);

                            const pathKey = `${dronesData[i].mission.type}|${waypointIndex}|${remainingWaypoints.map(point =>
                                `${point.lat.toFixed(6)},${point.lng.toFixed(6)}`
                            ).join('|')}`;
                            if (!plottedWaypointPaths.has(pathKey)) {
                                if (remainingWaypoints.length > 1) {
                                    L.polyline(remainingWaypoints, {
                                        color: routeColor, weight: 3, opacity: 0.85,
                                        interactive: false, renderer: overlayRenderer
                                    }).addTo(missionLayer);
                                }
                                remainingWaypoints.forEach((point, remainingIndex) => {
                                    L.circleMarker([point.lat, point.lng], {
                                        radius: remainingIndex === 0 ? 5 : 4,
                                        fillColor: routeColor,
                                        color: '#fff',
                                        weight: 1,
                                        fillOpacity: 1,
                                        interactive: false,
                                        renderer: overlayRenderer
                                    }).addTo(missionLayer);
                                });
                                plottedWaypointPaths.add(pathKey);
                            }
                        }
                    } else {
                        // Draw trajectory from the drone to its single mission target.
                        L.polyline([[dronesData[i].lat, dronesData[i].lng], [dronesData[i].mission.target.lat, dronesData[i].mission.target.lng]], {
                            color: '#f39c12', weight: 2, dashArray: '5, 8', opacity: 0.8, renderer: overlayRenderer
                        }).addTo(missionLayer);

                        L.circleMarker([dronesData[i].mission.target.lat, dronesData[i].mission.target.lng], {
                            radius: dronesData[i].mission.type === 'goto' ? 6 : 8,
                            fillColor: dronesData[i].mission.type === 'goto' ? '#ff2d2d' : '#f39c12',
                            color: '#fff', weight: 2, fillOpacity: 1, renderer: overlayRenderer
                        }).bindTooltip(
                            dronesData[i].mission.type === 'goto' ? 'GO TO LOCATION' : `${dronesData[i].mission.type.toUpperCase()} CENTRE`,
                            { permanent: true, direction: 'top', className: 'drone-marker-label' }
                        ).addTo(missionLayer);
                    }

                    // --- RENDER CONTINUOUS FLIGHT ORBIT CIRCLE ONCE ASSIGNED ---
                    if (dronesData[i].mission.type === 'orbit') {
                        const orbitKey = `${dronesData[i].mission.target.lat.toFixed(4)}_${dronesData[i].mission.target.lng.toFixed(4)}_${dronesData[i].mission.radius}`;
                        if (!plottedOrbits.has(orbitKey)) {
                            L.circle([dronesData[i].mission.target.lat, dronesData[i].mission.target.lng], {
                                radius: dronesData[i].mission.radius * 1000,
                                color: '#e67e22',
                                weight: 1.5,
                                dashArray: '6, 6',
                                fill: false,
                                opacity: 0.7,
                                interactive: false,
                                renderer: overlayRenderer
                            }).addTo(missionLayer);
                            plottedOrbits.add(orbitKey);
                        }
                    }
                }

                for (let j = i + 1; j < dronesData.length; j++) {
                    if (getDistanceKM(dronesData[i].lat, dronesData[i].lng, dronesData[j].lat, dronesData[j].lng) <= INTER_DRONE_RANGE_KM) {
                        const meshColor = (dronesData[i].cluster !== -1 && dronesData[i].cluster === dronesData[j].cluster)
                            ? (clusterColors[dronesData[i].cluster] || '#1abc9c') : '#0099ff';
                        const meshKey = `${dronesData[i].id}|${dronesData[j].id}`;
                        const points = [[dronesData[i].lat, dronesData[i].lng], [dronesData[j].lat, dronesData[j].lng]];
                        activeMeshKeys.add(meshKey);
                        if (meshLines.has(meshKey)) {
                            meshLines.get(meshKey).setLatLngs(points).setStyle({ color: meshColor });
                        } else {
                            meshLines.set(meshKey, L.polyline(points, {
                                color: meshColor, weight: 2, dashArray: '3, 4', opacity: 0.55,
                                interactive: false, renderer: overlayRenderer
                            }).addTo(meshLayer));
                        }
                    }
                }
            }

            meshLines.forEach((line, key) => {
                if (!activeMeshKeys.has(key)) {
                    meshLayer.removeLayer(line);
                    meshLines.delete(key);
                }
            });

            if (!isFlyMode) evaluateAndSteerADRFleet();
            updateSystemMapLegend(force);
            if (!isFlyMode) {
                updateSummaryDataBoxes(force);
                updateTelemetryPanel(force);
            }
        }

        function scheduleDragMarkerUpdate() {
            if (dragMarkerUpdateRequested) return;
            dragMarkerUpdateRequested = true;
            dragUpdateFrame = requestAnimationFrame(() => {
                dragMarkerUpdateRequested = false;
                dragUpdateFrame = null;
                updateDragMarkers();
            });
        }

        function updateDragMarkers() {
            dronesData.forEach(d => {
                if (droneMarkers[d.id]) {
                    droneMarkers[d.id].setLatLng([d.lat, d.lng]);
                }
            });
            if (selectedTelemetryDroneId) {
                updateTelemetryPanel(false);
            }
        }

        function updateMissionMovementVisuals(timestamp, forceStaticRefresh = false) {
            const refreshHeadingIcon = forceStaticRefresh || timestamp - lastHeadingVisualUpdate >= 100;
            dronesData.forEach(drone => {
                const isMoving = drone.mission?.active || drone.rtlAction || drone.rthAction || drone.verticalAction;
                if (isMoving) recordDroneFlightTrack(drone);
                if (isMoving || forceStaticRefresh) {
                    if (droneMarkers[drone.id]) {
                        droneMarkers[drone.id].setLatLng([drone.lat, drone.lng]);
                        if (refreshHeadingIcon) droneMarkers[drone.id].setIcon(createDroneMarkerIcon(drone));
                    }
                    if (drone.id === selectedTelemetryDroneId) {
                        const homeLat = isFlyMode && Number.isFinite(drone.homeLat) ? drone.homeLat : BASE_LAT;
                        const homeLng = isFlyMode && Number.isFinite(drone.homeLng) ? drone.homeLng : BASE_LON;
                        drone.dist_home_km = getDistanceKM(drone.lat, drone.lng, homeLat, homeLng);
                        const clippedDist = Math.max(drone.dist_home_km, 0.1);
                        drone.rssi_dbm = -50.0 - 10 * 3.8 * Math.log10(clippedDist);
                        updateTelemetryPanel();
                    }
                }
            });
            if (refreshHeadingIcon) lastHeadingVisualUpdate = timestamp;

            if (forceStaticRefresh || timestamp - lastMissionVisualUpdate >= MISSION_VISUAL_UPDATE_INTERVAL_MS) {
                lastMissionVisualUpdate = timestamp;
                drawStaticNetworkVisuals(forceStaticRefresh);
            }
        }

        function advanceDroneAlongWaypointPath(drone, movementBudgetKm, deltaTimeSecs) {
            const mission = drone.mission;
            const minimumMovementKm = 1e-9;
            if (!mission || !mission.active || !Array.isArray(mission.waypoints) ||
                mission.waypoints.length === 0 || movementBudgetKm <= minimumMovementKm) {
                return;
            }

            const currentWaypoint = mission.waypoints[mission.waypointIndex];
            if (currentWaypoint) {
                const initialDistance = getDistanceKM(drone.lat, drone.lng, currentWaypoint.lat, currentWaypoint.lng);
                if (initialDistance > minimumMovementKm) {
                    const desiredHeading = getBearing(drone.lat, drone.lng, currentWaypoint.lat, currentWaypoint.lng);
                    if (!turnDroneTowardHeading(drone, desiredHeading, deltaTimeSecs)) return;
                }
            }

            let remainingDistanceKm = movementBudgetKm;
            let processedTransitions = 0;
            const maxTransitionsPerFrame = Math.max(100, mission.waypoints.length * 10);

            // The loop is only needed when one animation frame has enough movement to
            // cross a waypoint. A partial segment always exits after one calculation.
            while (mission.active && remainingDistanceKm > minimumMovementKm) {
                processedTransitions++;
                if (processedTransitions > maxTransitionsPerFrame) break;
                const waypoint = mission.waypoints[mission.waypointIndex];
                if (!waypoint) {
                    mission.active = false;
                    mission.completed = true;
                    break;
                }

                const distanceToWaypoint = getDistanceKM(drone.lat, drone.lng, waypoint.lat, waypoint.lng);
                const bearing = getBearing(drone.lat, drone.lng, waypoint.lat, waypoint.lng);

                if (distanceToWaypoint <= remainingDistanceKm + 1e-9) {
                    drone.lat = waypoint.lat;
                    drone.lng = waypoint.lng;
                    if (distanceToWaypoint > minimumMovementKm) drone.heading = bearing;
                    remainingDistanceKm = Math.max(0, remainingDistanceKm - distanceToWaypoint);
                    mission.waypointIndex++;

                    if (mission.waypointIndex >= mission.waypoints.length) {
                        if (mission.type === 'survey') {
                            mission.completedSurveyLoops = (mission.completedSurveyLoops || 0) + 1;
                            const requestedLoops = Math.max(1, Math.floor(mission.surveyLoopCount || 1));
                            if (mission.completedSurveyLoops < requestedLoops) {
                                mission.waypointIndex = 0;
                                mission.target = { ...mission.waypoints[0] };
                                if (remainingDistanceKm <= minimumMovementKm) break;
                                continue;
                            }
                        }
                        mission.active = false;
                        mission.completed = true;
                        break;
                    }
                    mission.target = { ...mission.waypoints[mission.waypointIndex] };
                    if (remainingDistanceKm <= minimumMovementKm) break;
                } else {
                    const nextPosition = getPointAtDistanceAndBearing(
                        drone.lat,
                        drone.lng,
                        remainingDistanceKm,
                        bearing
                    );
                    drone.lat = nextPosition.lat;
                    drone.lng = nextPosition.lng;
                    drone.heading = bearing;
                    break;
                }
            }
        }

        let lastTime = 0;
        function animationLoop(timestamp) {
            if (!lastTime) lastTime = timestamp;
            // Prevent a backgrounded browser tab from producing one enormous movement
            // step when requestAnimationFrame resumes.
            const deltaTimeSecs = Math.min((timestamp - lastTime) / 1000, 1.0);
            lastTime = timestamp;

            let needsVisualUpdate = false;
            let missionCompletedThisFrame = false;

            dronesData.forEach(drone => {
                if (drone.rthAction) {
                    needsVisualUpdate = true;
                    const rth = drone.rthAction;

                    if (rth.phase === 'arming') {
                        drone.flightState = 'ARMING';
                        rth.phaseElapsedSec += deltaTimeSecs;
                        if (rth.phaseElapsedSec >= rth.armingTimeSec) {
                            drone.armed = true;
                            drone.flightState = 'TAKING OFF';
                            rth.phase = 'takeoff';
                            rth.phaseElapsedSec = 0;
                        }
                        return;
                    }

                    if (rth.phase === 'takeoff') {
                        drone.armed = true;
                        drone.flightState = 'TAKING OFF';
                        
                        // Check takeoff restrictions for VTOL in MR-FW config
                        if (drone.airframe === 'vtol' && drone.vtolConfig === 'MR-FW' && drone.vtolMode === 'FW') {
                            drone.flightState = 'ERROR: Cannot takeoff in FW mode (MR-FW requires vertical takeoff)';
                            rth.phase = null; // Cancel action
                            return;
                        }
                        
                        const altitudeDifference = rth.takeoffAltitude - drone.altitude;
                        if (altitudeDifference <= 0) {
                            rth.phase = 'returning';
                            drone.flightState = 'RETURNING HOME';
                        } else if (drone.airframe === 'vtol') {
                            // Use VTOL-specific takeoff
                            vtolTakeoff(drone);
                            drone.velocity = drone.velocity || 1;
                            if (drone.altitude >= rth.takeoffAltitude - 1e-9) {
                                drone.altitude = rth.takeoffAltitude;
                                rth.phase = 'returning';
                                drone.flightState = 'RETURNING HOME';
                            }
                            return;
                        } else if (drone.airframe === 'fixed-wing') {
                            // Use Fixed-Wing-specific takeoff
                            fixedWingTakeoff(drone);
                            if (drone.altitude >= rth.takeoffAltitude - 1e-9) {
                                drone.altitude = rth.takeoffAltitude;
                                rth.phase = 'returning';
                                drone.flightState = 'RETURNING HOME';
                            }
                            return;
                        } else {
                            drone.altitude += Math.min(altitudeDifference, MISSION_TAKEOFF_RATE_MPS * deltaTimeSecs);
                            if (drone.altitude >= rth.takeoffAltitude - 1e-9) {
                                drone.altitude = rth.takeoffAltitude;
                                rth.phase = 'returning';
                                drone.flightState = 'RETURNING HOME';
                            }
                            return;
                        }
                    }

                    if (rth.phase === 'returning') {
                        drone.flightState = 'RETURNING HOME';
                        // Update VTOL flight dynamics during cruise
                        updateVtolFlightDynamics(drone, deltaTimeSecs);
                        const distanceHomeKm = getDistanceKM(drone.lat, drone.lng, rth.homeLat, rth.homeLng);
                        const movementKm = (rth.velocityMps / 1000) * deltaTimeSecs;
                        if (distanceHomeKm > 1e-9) {
                            const desiredHeading = getBearing(drone.lat, drone.lng, rth.homeLat, rth.homeLng);
                            if (!turnDroneTowardHeading(drone, desiredHeading, deltaTimeSecs)) return;
                        }
                        if (distanceHomeKm <= movementKm + 1e-9) {
                            drone.lat = rth.homeLat;
                            drone.lng = rth.homeLng;
                            rth.phase = 'landing';
                            rth.phaseElapsedSec = 0;
                            rth.landingStartAltitude = drone.altitude;
                            drone.flightState = 'LANDING';
                            return;
                        }
                        const bearing = getBearing(drone.lat, drone.lng, rth.homeLat, rth.homeLng);
                        const nextPosition = getPointAtDistanceAndBearing(drone.lat, drone.lng, movementKm, bearing);
                        drone.lat = nextPosition.lat;
                        drone.lng = nextPosition.lng;
                        drone.heading = bearing;
                        return;
                    }

                    if (rth.phase === 'landing') {
                        drone.flightState = 'LANDING';
                        if (drone.airframe === 'vtol') {
                            // Use VTOL-specific landing with configuration-dependent behavior
                            const isLanding = vtolLanding(drone, 0);
                            if (!isLanding) {
                                drone.altitude = 0;
                                drone.velocity = 0;
                                drone.armed = false;
                                drone.flightState = 'LANDED';
                                drone.rthAction = null;
                                missionCompletedThisFrame = true;
                            }
                        } else if (drone.airframe === 'fixed-wing') {
                            // Use Fixed-Wing-specific landing with horizontal descent
                            const isLanding = fixedWingLanding(drone, 0);
                            if (!isLanding) {
                                drone.altitude = 0;
                                drone.velocity = 0;
                                drone.armed = false;
                                drone.flightState = 'LANDED';
                                drone.rthAction = null;
                                missionCompletedThisFrame = true;
                            }
                        } else {
                            rth.phaseElapsedSec += deltaTimeSecs;
                            const landingProgress = Math.min(1, rth.phaseElapsedSec / rth.landingTimeSec);
                            drone.altitude = Math.max(0, rth.landingStartAltitude * (1 - landingProgress));
                            if (landingProgress >= 1) {
                                drone.altitude = 0;
                                drone.velocity = 0;
                                drone.armed = false;
                                drone.flightState = 'LANDED';
                                drone.rthAction = null;
                                missionCompletedThisFrame = true;
                            }
                        }
                        return;
                    }
                }

                if (drone.rtlAction) {
                    needsVisualUpdate = true;
                    // Update VTOL flight dynamics during return to launch
                    updateVtolFlightDynamics(drone, deltaTimeSecs);
                    const rtl = drone.rtlAction;
                    const distanceLaunchKm = getDistanceKM(drone.lat, drone.lng, rtl.launchLat, rtl.launchLng);
                    const movementKm = (rtl.velocityMps / 1000) * deltaTimeSecs;
                    if (distanceLaunchKm > 1e-9) {
                        const desiredHeading = getBearing(drone.lat, drone.lng, rtl.launchLat, rtl.launchLng);
                        if (!turnDroneTowardHeading(drone, desiredHeading, deltaTimeSecs)) return;
                    }
                    if (distanceLaunchKm <= movementKm + 1e-9) {
                        drone.lat = rtl.launchLat;
                        drone.lng = rtl.launchLng;
                        drone.rtlAction = null;
                        drone.flightState = 'LANDING';
                        drone.verticalAction = { type: 'land', targetAltitude: 0, rateMps: 4 };
                        missionCompletedThisFrame = true;
                    } else {
                        const bearing = getBearing(drone.lat, drone.lng, rtl.launchLat, rtl.launchLng);
                        const nextPosition = getPointAtDistanceAndBearing(drone.lat, drone.lng, movementKm, bearing);
                        drone.lat = nextPosition.lat;
                        drone.lng = nextPosition.lng;
                        drone.heading = bearing;
                    }
                }

                if (drone.verticalAction) {
                    needsVisualUpdate = true;
                    const action = drone.verticalAction;
                    
                    // Check VTOL takeoff restrictions in FLY mode
                    if (action.type === 'takeoff' && drone.airframe === 'vtol' && drone.vtolConfig === 'MR-FW' && drone.vtolMode === 'FW') {
                        drone.flightState = 'ERROR: Cannot takeoff in FW mode (MR-FW requires vertical takeoff)';
                        drone.verticalAction = null;
                    } else if (action.type === 'takeoff' && drone.airframe === 'vtol') {
                        // Use VTOL-specific takeoff in FLY mode
                        vtolTakeoff(drone);
                        drone.velocity = drone.velocity || 1;
                        if (drone.altitude >= action.targetAltitude - 1e-9) {
                            drone.altitude = action.targetAltitude;
                            drone.flightState = 'IN FLIGHT';
                            drone.verticalAction = null;
                            missionCompletedThisFrame = true;
                        }
                    } else if (action.type === 'takeoff' && drone.airframe === 'fixed-wing') {
                        // Use Fixed-Wing-specific takeoff in FLY mode
                        fixedWingTakeoff(drone);
                        if (drone.altitude >= action.targetAltitude - 1e-9) {
                            drone.altitude = action.targetAltitude;
                            drone.flightState = 'IN FLIGHT';
                            drone.verticalAction = null;
                            missionCompletedThisFrame = true;
                        }
                    } else if (action.type === 'land' && drone.airframe === 'vtol') {
                        // Use VTOL-specific landing in FLY mode
                        const isLanding = vtolLanding(drone, action.targetAltitude);
                        if (!isLanding) {
                            drone.altitude = action.targetAltitude;
                            drone.armed = false;
                            drone.flightState = 'LANDED';
                            drone.verticalAction = null;
                            missionCompletedThisFrame = true;
                        }
                    } else if (action.type === 'land' && drone.airframe === 'fixed-wing') {
                        // Use Fixed-Wing-specific landing in FLY mode
                        const isLanding = fixedWingLanding(drone, action.targetAltitude);
                        if (!isLanding) {
                            drone.altitude = action.targetAltitude;
                            drone.armed = false;
                            drone.flightState = 'LANDED';
                            drone.verticalAction = null;
                            missionCompletedThisFrame = true;
                        }
                    } else {
                        // Standard vertical action for non-VTOL drones
                        const altitudeDifference = action.targetAltitude - drone.altitude;
                        const verticalStep = action.rateMps * deltaTimeSecs;
                        if (Math.abs(altitudeDifference) <= verticalStep) {
                            drone.altitude = action.targetAltitude;
                            if (action.type === 'land') {
                                drone.armed = false;
                                drone.flightState = 'LANDED';
                            } else {
                                drone.flightState = 'IN FLIGHT';
                            }
                            drone.verticalAction = null;
                            missionCompletedThisFrame = true;
                        } else {
                            drone.altitude += Math.sign(altitudeDifference) * verticalStep;
                        }
                    }
                }

                if (drone.mission && drone.mission.active && !drone.mission.paused) {
                    const mission = drone.mission;
                    const wasActive = mission.active;
                    needsVisualUpdate = true;

                    if (mission.phase === 'arming') {
                        drone.flightState = 'ARMING';
                        mission.phaseElapsedSec += deltaTimeSecs;
                        if (mission.phaseElapsedSec >= mission.armingTimeSec) {
                            drone.armed = true;
                            drone.flightState = 'TAKING OFF';
                            mission.phase = 'takeoff';
                            mission.phaseElapsedSec = 0;
                        }
                        return;
                    }

                    if (mission.phase === 'takeoff') {
                        drone.armed = true;
                        drone.flightState = 'TAKING OFF';
                        
                        // Check takeoff restrictions for VTOL in MR-FW config
                        if (drone.airframe === 'vtol' && drone.vtolConfig === 'MR-FW' && drone.vtolMode === 'FW') {
                            drone.flightState = 'ERROR: Cannot takeoff in FW mode (MR-FW requires vertical takeoff)';
                            mission.active = false;
                            return;
                        }
                        
                        const altitudeDifference = mission.takeoffAltitude - drone.altitude;
                        if (altitudeDifference <= 0) {
                            mission.phase = 'enroute';
                            drone.flightState = 'IN FLIGHT';
                        } else if (drone.airframe === 'vtol') {
                            // Use VTOL-specific takeoff
                            vtolTakeoff(drone);
                            drone.velocity = drone.velocity || 1;
                            if (drone.altitude >= mission.takeoffAltitude - 1e-9) {
                                drone.altitude = mission.takeoffAltitude;
                                mission.phase = 'enroute';
                                drone.flightState = 'IN FLIGHT';
                            }
                            return;
                        } else if (drone.airframe === 'fixed-wing') {
                            // Use Fixed-Wing-specific takeoff
                            fixedWingTakeoff(drone);
                            if (drone.altitude >= mission.takeoffAltitude - 1e-9) {
                                drone.altitude = mission.takeoffAltitude;
                                mission.phase = 'enroute';
                                drone.flightState = 'IN FLIGHT';
                            }
                            return;
                        } else {
                            drone.altitude += Math.min(altitudeDifference, MISSION_TAKEOFF_RATE_MPS * deltaTimeSecs);
                            if (drone.altitude >= mission.takeoffAltitude - 1e-9) {
                                drone.altitude = mission.takeoffAltitude;
                                mission.phase = 'enroute';
                                drone.flightState = 'IN FLIGHT';
                            }
                            return;
                        }
                    }

                    if (mission.phase === 'landing') {
                        drone.flightState = 'LANDING';
                        if (drone.airframe === 'vtol') {
                            // Use VTOL-specific landing with configuration-dependent behavior
                            const isLanding = vtolLanding(drone, 0);
                            if (!isLanding) {
                                drone.altitude = 0;
                                drone.velocity = 0;
                                drone.armed = false;
                                drone.flightState = 'LANDED';
                                mission.active = false;
                                mission.completed = true;
                                startNextMissionRole(drone);
                                missionCompletedThisFrame = true;
                            }
                        } else if (drone.airframe === 'fixed-wing') {
                            // Use Fixed-Wing-specific landing with horizontal descent
                            const isLanding = fixedWingLanding(drone, 0);
                            if (!isLanding) {
                                drone.altitude = 0;
                                drone.velocity = 0;
                                drone.armed = false;
                                drone.flightState = 'LANDED';
                                mission.active = false;
                                mission.completed = true;
                                startNextMissionRole(drone);
                                missionCompletedThisFrame = true;
                            }
                        } else {
                            mission.phaseElapsedSec += deltaTimeSecs;
                            const landingProgress = Math.min(1, mission.phaseElapsedSec / mission.landingTimeSec);
                            drone.altitude = Math.max(0, mission.landingStartAltitude * (1 - landingProgress));
                            if (landingProgress >= 1) {
                                drone.altitude = 0;
                                drone.velocity = 0;
                                drone.armed = false;
                                drone.flightState = 'LANDED';
                                mission.active = false;
                                mission.completed = true;
                                startNextMissionRole(drone);
                                missionCompletedThisFrame = true;
                            }
                        }
                        return;
                    }

                    // Update VTOL flight dynamics during enroute phases
                    updateVtolFlightDynamics(drone, deltaTimeSecs);
                    const moveDist = (mission.velocity / 1000) * deltaTimeSecs; 

                    if (mission.type === 'goto') {
                        const distToTarget = getDistanceKM(drone.lat, drone.lng, mission.target.lat, mission.target.lng);
                        const bearing = getBearing(drone.lat, drone.lng, mission.target.lat, mission.target.lng);
                        if (distToTarget > 1e-9 && !turnDroneTowardHeading(drone, bearing, deltaTimeSecs)) return;
                        if (distToTarget <= moveDist) {
                            drone.lat = mission.target.lat;
                            drone.lng = mission.target.lng;
                            if (mission.hoverAtDestination) {
                                mission.phase = 'hovering';
                                mission.active = false;
                                mission.completed = true;
                                drone.velocity = 0;
                                drone.flightState = 'HOVERING';
                            } else {
                                mission.phase = 'landing';
                                mission.phaseElapsedSec = 0;
                                mission.landingStartAltitude = drone.altitude;
                                drone.flightState = 'LANDING';
                            }
                        } else {
                            const nextPos = getPointAtDistanceAndBearing(drone.lat, drone.lng, moveDist, bearing);
                            drone.lat = nextPos.lat;
                            drone.lng = nextPos.lng;
                            drone.heading = bearing; 
                        }
                    } else if (mission.type === 'orbit') {
                        const distToTarget = getDistanceKM(drone.lat, drone.lng, mission.target.lat, mission.target.lng);
                        const orbitRadiusKm = mission.radius || 1.0; 
                        
                        if (!mission.inOrbit) {
                            // Join the nearest point on the orbit circumference. This works for
                            // drones starting both outside and inside the requested orbit.
                            const radialBearing = distToTarget > 1e-9
                                ? getBearing(mission.target.lat, mission.target.lng, drone.lat, drone.lng)
                                : ((drone.heading || 0) + 180) % 360;
                            const orbitEntry = getPointAtDistanceAndBearing(
                                mission.target.lat,
                                mission.target.lng,
                                orbitRadiusKm,
                                radialBearing
                            );
                            const distToEntry = getDistanceKM(drone.lat, drone.lng, orbitEntry.lat, orbitEntry.lng);
                            const entryBearing = getBearing(drone.lat, drone.lng, orbitEntry.lat, orbitEntry.lng);
                            if (distToEntry > 1e-9 && !turnDroneTowardHeading(drone, entryBearing, deltaTimeSecs)) return;
                            if (distToEntry <= Math.max(moveDist, 0.01)) {
                                drone.lat = orbitEntry.lat;
                                drone.lng = orbitEntry.lng;
                                mission.inOrbit = true;
                                mission.orbitEntrySide = distToTarget >= orbitRadiusKm ? 'outside' : 'inside';
                            } else {
                                const nextPos = getPointAtDistanceAndBearing(drone.lat, drone.lng, moveDist, entryBearing);
                                drone.lat = nextPos.lat;
                                drone.lng = nextPos.lng;
                                drone.heading = entryBearing;
                            }
                        } else {
                            let currentAngle = getBearing(mission.target.lat, mission.target.lng, drone.lat, drone.lng);
                            const tangentHeading = (currentAngle + 90) % 360;
                            if (!turnDroneTowardHeading(drone, tangentHeading, deltaTimeSecs)) return;
                            const angularVelocityDeg = (moveDist / orbitRadiusKm) * (180 / Math.PI);
                            currentAngle = (currentAngle + angularVelocityDeg) % 360;
                            
                            const nextPos = getPointAtDistanceAndBearing(mission.target.lat, mission.target.lng, orbitRadiusKm, currentAngle);
                            drone.lat = nextPos.lat;
                            drone.lng = nextPos.lng;
                            drone.heading = (currentAngle + 90) % 360; 
                            if (Number.isFinite(mission.orbitLoops)) {
                                mission.orbitTravelDeg = (mission.orbitTravelDeg || 0) + Math.abs(angularVelocityDeg);
                                if (mission.orbitTravelDeg >= mission.orbitLoops * 360) {
                                    mission.phase = 'hovering';
                                    mission.active = false;
                                    mission.completed = true;
                                    drone.velocity = 0;
                                    drone.flightState = 'HOVERING';
                                }
                            }
                        }
                    } else if (mission.type === 'waypoint' || mission.type === 'survey') {
                        advanceDroneAlongWaypointPath(drone, moveDist, deltaTimeSecs);
                    }
                    if (wasActive && !mission.active) {
                        const nextRoleStarted = mission.completed && startNextMissionRole(drone);
                        if (!nextRoleStarted && mission.phase !== 'hovering') drone.flightState = 'IN FLIGHT';
                        missionCompletedThisFrame = true;
                    }
                }
            });

            if (!isFlyMode) {
                let adrYawChanged = false;
                adrFleet.forEach(bird => {
                    if (!Number.isFinite(bird.commandedHeading)) return;
                    const previousHeading = bird.heading;
                    turnDroneTowardHeading(bird, bird.commandedHeading, deltaTimeSecs);
                    if (angularDifferenceDeg(previousHeading, bird.heading) > 1e-6) adrYawChanged = true;
                });

                if (adrYawChanged) {
                    adrFleet.forEach(bird => {
                        const marker = adrMarkers.get(bird.id);
                        const rotationAssembly = marker?.getElement()?.querySelector('.adr-rotation-assembly');
                        if (rotationAssembly) {
                            rotationAssembly.style.transform = `rotate(${normalizeHeading(bird.heading)}deg)`;
                        }

                        const fovPolygon = adrFovPolygons.get(bird.id);
                        if (fovPolygon) {
                            fovPolygon.setLatLngs(
                                getFovPolygonPoints(bird.lat, bird.lng, bird.heading, ADR_MAX_RANGE_KM, ADR_FOV_DEG)
                            );
                        }

                        const headingLine = adrHeadingLines.get(bird.id);
                        if (headingLine) {
                            const headingEnd = getPointAtDistanceAndBearing(
                                bird.lat,
                                bird.lng,
                                ADR_MAX_RANGE_KM,
                                bird.heading
                            );
                            headingLine.setLatLngs([
                                [bird.lat, bird.lng],
                                [headingEnd.lat, headingEnd.lng]
                            ]);
                        }
                    });
                }
            }

            if (needsVisualUpdate) {
                updateMissionMovementVisuals(timestamp, missionCompletedThisFrame);
            }
            if (isFlyMode) updateFlyTelemetryPanel(false);
            requestAnimationFrame(animationLoop);
        }
        requestAnimationFrame(animationLoop);

        function angularDifferenceDeg(a, b) {
            return Math.abs((a - b + 540) % 360 - 180);
        }

        // Build the communication graph used by the ADR controller.
        // 1) A drone is directly connected when it is inside GCS range and its RSSI is usable.
        // 2) Every directly connected drone becomes a mesh gateway.
        // 3) Breadth-first search propagates GCS connectivity through inter-drone links.
        // 4) ADR service is requested only for drones with no direct or mesh path, or for
        //    links already degrading near the GCS edge.
        function updateGcsMeshConnectivity() {
            const neighbours = new Map(dronesData.map(drone => [drone.id, []]));
            for (let i = 0; i < dronesData.length; i++) {
                for (let j = i + 1; j < dronesData.length; j++) {
                    const distanceKm = getDistanceKM(
                        dronesData[i].lat, dronesData[i].lng,
                        dronesData[j].lat, dronesData[j].lng
                    );
                    if (distanceKm <= INTER_DRONE_RANGE_KM) {
                        neighbours.get(dronesData[i].id).push(dronesData[j]);
                        neighbours.get(dronesData[j].id).push(dronesData[i]);
                    }
                }
            }

            const queue = [];
            dronesData.forEach(drone => {
                const distanceKm = Number.isFinite(drone.dist_home_km)
                    ? drone.dist_home_km
                    : getDistanceKM(BASE_LAT, BASE_LON, drone.lat, drone.lng);
                const directRangeOk = distanceKm <= GCS_RANGE_LIMIT_KM;
                const directSignalOk = !Number.isFinite(drone.rssi_dbm) || drone.rssi_dbm > ADR_COVERAGE_RSSI_THRESHOLD;
                drone.directGcsConnected = directRangeOk && directSignalOk;
                drone.meshGcsConnected = drone.directGcsConnected;
                drone.gcsHopCount = drone.directGcsConnected ? 0 : Number.POSITIVE_INFINITY;
                drone.gcsGatewayId = drone.directGcsConnected ? drone.id : null;
                if (drone.directGcsConnected) queue.push(drone);
            });

            for (let cursor = 0; cursor < queue.length; cursor++) {
                const gateway = queue[cursor];
                (neighbours.get(gateway.id) || []).forEach(neighbour => {
                    const nextHopCount = gateway.gcsHopCount + 1;
                    if (!neighbour.meshGcsConnected || nextHopCount < neighbour.gcsHopCount) {
                        neighbour.meshGcsConnected = true;
                        neighbour.gcsHopCount = nextHopCount;
                        neighbour.gcsGatewayId = gateway.gcsGatewayId || gateway.id;
                        queue.push(neighbour);
                    }
                });
            }

            dronesData.forEach(drone => {
                const nearEdge = drone.dist_home_km >= GCS_RANGE_LIMIT_KM * GCS_EDGE_TRIGGER_RATIO;
                const weakSignal = Number.isFinite(drone.rssi_dbm) && drone.rssi_dbm <= CRITICAL_RSSI_THRESHOLD;
                drone.requiresAdr = !drone.meshGcsConnected || (drone.directGcsConnected && nearEdge && weakSignal);
                drone.communicationMode = drone.requiresAdr
                    ? 'ADR REQUIRED'
                    : drone.directGcsConnected
                        ? 'DIRECT GCS'
                        : `MESH TO GCS (${drone.gcsHopCount} hop${drone.gcsHopCount === 1 ? '' : 's'})`;
            });
        }

        function getClusterOperationalSummary() {
            updateGcsMeshConnectivity();
            const summaries = [];
            const clusterMap = new Map();

            // Keep DBSCAN clusters, but also treat every unclustered drone as a serviceable
            // single-node group so an isolated lost drone can still attract an ADR bird.
            dronesData.forEach((drone, index) => {
                const clusterId = drone.cluster === -1 ? `U_${drone.id}` : drone.cluster;
                if (!clusterMap.has(clusterId)) clusterMap.set(clusterId, []);
                clusterMap.get(clusterId).push(drone);
            });

            clusterMap.forEach((allMembers, clusterId) => {
                const members = allMembers.filter(drone => drone.requiresAdr);
                if (members.length === 0) return;

                const centroid = members.reduce((acc, d) => {
                    acc.lat += d.lat;
                    acc.lng += d.lng;
                    return acc;
                }, { lat: 0, lng: 0 });
                centroid.lat /= members.length;
                centroid.lng /= members.length;

                const avgDistance = members.reduce((sum, d) => sum + d.dist_home_km, 0) / members.length;
                const maxDistance = Math.max(...members.map(d => d.dist_home_km));
                const avgRssi = members.reduce((sum, d) => sum + d.rssi_dbm, 0) / members.length;
                const disconnectedNodes = members.filter(d => !d.meshGcsConnected).length;
                const weakNodes = members.filter(d => d.rssi_dbm <= CRITICAL_RSSI_THRESHOLD).length;
                const directCoverage = disconnectedNodes === 0;
                const approachingEdge = members.some(d =>
                    d.dist_home_km >= GCS_RANGE_LIMIT_KM * GCS_EDGE_TRIGGER_RATIO ||
                    d.rssi_dbm <= CRITICAL_RSSI_THRESHOLD
                );

                summaries.push({
                    id: clusterId,
                    members,
                    allMembers,
                    centroidLat: centroid.lat,
                    centroidLng: centroid.lng,
                    avgDistance,
                    maxDistance,
                    avgRssi,
                    directCoverage,
                    approachingEdge,
                    disconnectedNodes,
                    weakNodes,
                    priorityScore:
                        disconnectedNodes * 4.0 +
                        weakNodes * 1.5 +
                        (maxDistance / GCS_RANGE_LIMIT_KM) * 0.8 +
                        Math.max(0, (-avgRssi - 65) / 35) * 0.8 +
                        Math.min(members.length / 10, 1) * 0.4
                });
            });

            return summaries.sort((a, b) => b.priorityScore - a.priorityScore);
        }

        function targetInsideAdrFov(adr, targetLat, targetLng) {
            const distance = getDistanceKM(adr.lat, adr.lng, targetLat, targetLng);
            if (distance > ADR_MAX_RANGE_KM) return false;
            const bearing = getBearing(adr.lat, adr.lng, targetLat, targetLng);
            return angularDifferenceDeg(bearing, adr.heading) <= ADR_FOV_DEG / 2;
        }

        function getCoverageForCluster(position, heading, cluster) {
            let coveredNodes = 0;
            cluster.members.forEach(node => {
                const distance = getDistanceKM(position.lat, position.lng, node.lat, node.lng);
                const bearing = getBearing(position.lat, position.lng, node.lat, node.lng);
                const angleError = angularDifferenceDeg(bearing, heading);
                if (distance <= ADR_MAX_RANGE_KM && angleError <= ADR_FOV_DEG / 2) coveredNodes++;
            });
            const requiredNodes = Math.min(MIN_CLUSTER_NODES_IN_FOV, cluster.members.length);
            return {
                coveredNodes,
                totalNodes: cluster.members.length,
                requiredNodes,
                ratio: cluster.members.length ? coveredNodes / cluster.members.length : 0,
                supported: requiredNodes > 0 && coveredNodes >= requiredNodes,
                full: cluster.members.length > 0 && coveredNodes === cluster.members.length
            };
        }

        function circularMeanDegrees(angles) {
            if (!angles.length) return 0;
            let sumSin = 0, sumCos = 0;
            angles.forEach(angle => {
                const rad = angle * Math.PI / 180;
                sumSin += Math.sin(rad);
                sumCos += Math.cos(rad);
            });
            return (Math.atan2(sumSin, sumCos) * 180 / Math.PI + 360) % 360;
        }

        function normalizeHeading(angle) {
            return (angle % 360 + 360) % 360;
        }

        // Aim the ADR's visual nose and FOV centre at the clusters it is serving.
        // A member-weighted circular mean also behaves correctly across 0/360 degrees.
        function getAdrClusterFocusHeading(bird, targets, fallbackHeading) {
            if (!targets.length) return normalizeHeading(fallbackHeading);

            let sumSin = 0;
            let sumCos = 0;
            targets.forEach(target => {
                const bearing = getBearing(
                    bird.lat,
                    bird.lng,
                    target.centroidLat,
                    target.centroidLng
                );
                const weight = Math.max(1, target.members?.length || 1);
                const bearingRad = bearing * Math.PI / 180;
                sumSin += Math.sin(bearingRad) * weight;
                sumCos += Math.cos(bearingRad) * weight;
            });

            if (Math.abs(sumSin) < 1e-9 && Math.abs(sumCos) < 1e-9) {
                return normalizeHeading(fallbackHeading);
            }
            return normalizeHeading(Math.atan2(sumSin, sumCos) * 180 / Math.PI);
        }


        function getLocalKm(lat, lng) {
            const point = convertGPSToLocalMetres(lat, lng);
            return { x: point.x / 1000, y: point.y / 1000 };
        }

        // Estimate the shared area of a candidate FOV with already assigned ADR FOVs.
        // Samples are distributed uniformly by area using sqrt(radius ratio).
        function estimateFovOverlapRatio(position, heading, reservedFovs) {
            if (!reservedFovs || reservedFovs.length === 0) return 0;

            const localPosition = getLocalKm(position.lat, position.lng);
            const cosineLimitSquared = Math.pow(Math.cos(ADR_FOV_DEG * Math.PI / 360), 2);
            const maxRangeSquared = ADR_MAX_RANGE_KM * ADR_MAX_RANGE_KM;
            const localFovs = reservedFovs.map(fov => {
                const local = (Number.isFinite(fov.localX) && Number.isFinite(fov.localY))
                    ? { x: fov.localX, y: fov.localY }
                    : getLocalKm(fov.lat, fov.lng);
                const headingRad = fov.heading * Math.PI / 180;
                return {
                    x: local.x,
                    y: local.y,
                    forwardX: Number.isFinite(fov.forwardX) ? fov.forwardX : Math.sin(headingRad),
                    forwardY: Number.isFinite(fov.forwardY) ? fov.forwardY : Math.cos(headingRad)
                };
            });

            let sampledPoints = 0;
            let overlappingPoints = 0;
            for (let rIndex = 0; rIndex < FOV_OVERLAP_RADIAL_SAMPLES; rIndex++) {
                const radialRatio = Math.sqrt((rIndex + 0.5) / FOV_OVERLAP_RADIAL_SAMPLES);
                const distanceKm = ADR_MAX_RANGE_KM * radialRatio;

                for (let aIndex = 0; aIndex < FOV_OVERLAP_ANGULAR_SAMPLES; aIndex++) {
                    const angleOffset = -ADR_FOV_DEG / 2 +
                        ADR_FOV_DEG * (aIndex + 0.5) / FOV_OVERLAP_ANGULAR_SAMPLES;
                    const sampleHeadingRad = normalizeHeading(heading + angleOffset) * Math.PI / 180;
                    const sampleX = localPosition.x + Math.sin(sampleHeadingRad) * distanceKm;
                    const sampleY = localPosition.y + Math.cos(sampleHeadingRad) * distanceKm;
                    sampledPoints++;
                    if (localFovs.some(fov => {
                        const deltaX = sampleX - fov.x;
                        const deltaY = sampleY - fov.y;
                        const distanceSquared = deltaX * deltaX + deltaY * deltaY;
                        if (distanceSquared > maxRangeSquared) return false;
                        const forwardDistance = deltaX * fov.forwardX + deltaY * fov.forwardY;
                        return forwardDistance >= 0 &&
                            forwardDistance * forwardDistance >= distanceSquared * cosineLimitSquared;
                    })) {
                        overlappingPoints++;
                    }
                }
            }
            return sampledPoints ? overlappingPoints / sampledPoints : 0;
        }

        // Candidate headings are generated from every drone, not only cluster centroids.
        // This prevents a compact cluster close to an FOV boundary from being missed even
        // though two of its members could still satisfy the relay rule.
        function buildPositionSnapshot(position, clusters) {
            return clusters.map(cluster => ({
                cluster,
                nodes: cluster.members.map(node => ({
                    distance: getDistanceKM(position.lat, position.lng, node.lat, node.lng),
                    bearing: getBearing(position.lat, position.lng, node.lat, node.lng)
                }))
            }));
        }

        function buildCandidateHeadings(snapshot) {
            const nodeBearings = [];
            snapshot.forEach(item => {
                item.nodes.forEach(node => nodeBearings.push(node.bearing));
            });

            const headings = new Set();
            const addHeading = h => headings.add(Math.round(normalizeHeading(h) * 10) / 10);

            // Uniform samples provide broad coverage without the cost of dense angular sweeps.
            for (let h = 0; h < 360; h += HEADING_SAMPLE_STEP_DEG) addHeading(h);

            nodeBearings.forEach(bearing => {
                addHeading(bearing);
                addHeading(bearing - ADR_FOV_DEG / 2 + 0.2);
                addHeading(bearing + ADR_FOV_DEG / 2 - 0.2);
            });

            return [...headings];
        }

        function scoreRelayPlan(snapshot, heading) {
            const coverage = snapshot.map(item => {
                let coveredNodes = 0;
                let coveredDistanceKm = 0;
                item.nodes.forEach(node => {
                    if (node.distance <= ADR_MAX_RANGE_KM &&
                        angularDifferenceDeg(node.bearing, heading) <= ADR_FOV_DEG / 2) {
                        coveredNodes++;
                        coveredDistanceKm += node.distance;
                    }
                });
                const totalNodes = item.nodes.length;
                const requiredNodes = Math.min(MIN_CLUSTER_NODES_IN_FOV, totalNodes);
                return {
                    cluster: item.cluster,
                    coveredNodes,
                    totalNodes,
                    requiredNodes,
                    coveredDistanceKm,
                    ratio: totalNodes ? coveredNodes / totalNodes : 0,
                    supported: requiredNodes > 0 && coveredNodes >= requiredNodes,
                    full: totalNodes > 0 && coveredNodes === totalNodes
                };
            });

            const supportedClusters = coverage.filter(item => item.supported);
            const partialClusters = coverage.filter(item => !item.supported && item.coveredNodes > 0);
            const supportedClusterPriority = supportedClusters.reduce((sum, item) => sum + item.cluster.priorityScore, 0);
            const coveredNodes = coverage.reduce((sum, item) => sum + item.coveredNodes, 0);
            const supportedNodes = supportedClusters.reduce((sum, item) => sum + item.coveredNodes, 0);
            const coveredDistanceKm = coverage.reduce((sum, item) => sum + item.coveredDistanceKm, 0);
            const supportedDistanceKm = supportedClusters.reduce((sum, item) => sum + item.coveredDistanceKm, 0);
            const partialCoverage = partialClusters.reduce((sum, item) => sum + item.ratio, 0);
            const minimumQualifiedMargin = supportedClusters.length
                ? Math.min(...supportedClusters.map(item => item.coveredNodes - item.requiredNodes))
                : -1;

            return {
                coverage,
                supportedClusters,
                partialClusters,
                supportedClusterCount: supportedClusters.length,
                supportedClusterPriority,
                coveredNodes,
                supportedNodes,
                meanCoveredDistanceKm: supportedNodes
                    ? supportedDistanceKm / supportedNodes
                    : (coveredNodes ? coveredDistanceKm / coveredNodes : Number.POSITIVE_INFINITY),
                partialCoverage,
                minimumQualifiedMargin
            };
        }

        function isBetterRelayPlan(candidate, best) {
            if (candidate.fovOverlapRatio > MAX_ADR_FOV_OVERLAP_RATIO + 1e-9) return false;
            if (!best) return true;

            // 1. Cover the maximum number of disconnected or critically weak service groups.
            if (candidate.supportedClusterCount !== best.supportedClusterCount)
                return candidate.supportedClusterCount > best.supportedClusterCount;

            // 2. Among equal cluster counts, retain more drones from those qualifying clusters.
            if (candidate.supportedNodes !== best.supportedNodes)
                return candidate.supportedNodes > best.supportedNodes;

            // 3. Prefer a robust solution that keeps qualifying clusters farther above the threshold.
            if (candidate.minimumQualifiedMargin !== best.minimumQualifiedMargin)
                return candidate.minimumQualifiedMargin > best.minimumQualifiedMargin;

            // 4. Then favor operationally weak or distant clusters and useful partial coverage.
            if (Math.abs(candidate.supportedClusterPriority - best.supportedClusterPriority) > 1e-9)
                return candidate.supportedClusterPriority > best.supportedClusterPriority;
            if (candidate.coveredNodes !== best.coveredNodes)
                return candidate.coveredNodes > best.coveredNodes;
            if (Math.abs(candidate.partialCoverage - best.partialCoverage) > 1e-9)
                return candidate.partialCoverage > best.partialCoverage;

            // 5. Prefer shared coverage only when it helps cluster support, but do not reject it outright.
            if (Math.abs(candidate.fovOverlapRatio - best.fovOverlapRatio) > 1e-9)
                return candidate.fovOverlapRatio < best.fovOverlapRatio;

            // 6. With equal FOV coverage, move toward the covered clusters while
            // remaining inside the GCS communication ring.
            if (Math.abs(candidate.meanCoveredDistanceKm - best.meanCoveredDistanceKm) > 1e-9)
                return candidate.meanCoveredDistanceKm < best.meanCoveredDistanceKm;

            // 7. Resolve a truly equal plan with the shorter GCS path.
            return candidate.distanceFromGcs < best.distanceFromGcs;
        }

        function evaluatePosition(position, radiusKm, clusters, best, reservedFovs = []) {
            // Distance and bearing are invariant for every yaw tested at this
            // position. Compute them once, then score headings with cheap numbers.
            const snapshot = buildPositionSnapshot(position, clusters);
            const headings = buildCandidateHeadings(snapshot);
            headings.forEach(heading => {
                const score = scoreRelayPlan(snapshot, heading);
                const candidate = {
                    ...position,
                    heading,
                    distanceFromGcs: radiusKm,
                    fovOverlapRatio: estimateFovOverlapRatio(position, heading, reservedFovs),
                    ...score
                };
                if (isBetterRelayPlan(candidate, best.value)) best.value = candidate;
            });
        }

        // Global coarse search followed by local refinement. Candidate positions include
        // directions to every cluster and angular midpoints between clusters, which allows
        // the ADR to move sideways and include a cluster that would otherwise remain just
        // outside the sector boundary.
        function findMaximumClusterRelayPlan(clusters, reservedFovs = []) {
            if (!clusters.length) return null;

            const safeRadiusKm = GCS_RANGE_LIMIT_KM;
            const clusterBearings = clusters.map(cluster =>
                getBearing(BASE_LAT, BASE_LON, cluster.centroidLat, cluster.centroidLng)
            );
            const positionBearings = new Set();
            const addBearing = b => positionBearings.add(Math.round(normalizeHeading(b) * 10) / 10);

            for (let bearing = 0; bearing < 360; bearing += POSITION_BEARING_STEP_DEG) addBearing(bearing);
            clusterBearings.forEach(addBearing);
            for (let i = 0; i < clusterBearings.length; i++) {
                for (let j = i + 1; j < clusterBearings.length; j++) {
                    addBearing(circularMeanDegrees([clusterBearings[i], clusterBearings[j]]));
                }
            }

            const best = { value: null };

            // Search the full GCS coverage area so the ADR stays linked while moving
            // toward the position that places the most clusters inside its FOV.
            const coarseRadiiKm = [0];
            for (let radiusKm = 0.5; radiusKm < safeRadiusKm; radiusKm += 1.0) {
                coarseRadiiKm.push(radiusKm);
            }
            coarseRadiiKm.push(safeRadiusKm);
            coarseRadiiKm.forEach(radiusKm => {
                positionBearings.forEach(positionBearing => {
                    const position = getPointAtDistanceAndBearing(BASE_LAT, BASE_LON, radiusKm, positionBearing);
                    evaluatePosition(position, radiusKm, clusters, best, reservedFovs);
                });
            });

            if (!best.value) return null;

            // Refine position and yaw around the best coarse result.
            const bestBearing = getBearing(BASE_LAT, BASE_LON, best.value.lat, best.value.lng);
            const bestRadius = best.value.distanceFromGcs;
            for (let radiusOffset = -1.0; radiusOffset <= 1.0; radiusOffset += 0.5) {
                const radiusKm = Math.max(0, Math.min(safeRadiusKm, bestRadius + radiusOffset));
                for (let bearingOffset = -18; bearingOffset <= 18; bearingOffset += 6) {
                    const positionBearing = normalizeHeading(bestBearing + bearingOffset);
                    const position = getPointAtDistanceAndBearing(BASE_LAT, BASE_LON, radiusKm, positionBearing);
                    evaluatePosition(position, radiusKm, clusters, best, reservedFovs);
                }
            }

            const result = best.value;
            let selectedClusters = result.supportedClusters.map(item => item.cluster);
            if (!selectedClusters.length) {
                const partial = [...result.coverage]
                    .filter(item => item.coveredNodes > 0)
                    .sort((a, b) =>
                        b.coveredNodes - a.coveredNodes ||
                        b.ratio - a.ratio ||
                        b.cluster.priorityScore - a.cluster.priorityScore
                    )[0];
                selectedClusters = partial ? [partial.cluster] : [];
            }

            result.selectedClusters = selectedClusters;
            return result;
        }

        // Re-optimize yaw at the ADR's current smoothed position. This removes the temporary
        // mismatch where the FOV was drawn using the destination yaw while the bird had not
        // yet reached the destination position.
        function findBestHeadingAtCurrentPosition(position, clusters, reservedFovs = []) {
            let best = null;
            const snapshot = buildPositionSnapshot(position, clusters);
            buildCandidateHeadings(snapshot).forEach(heading => {
                const score = scoreRelayPlan(snapshot, heading);
                const candidate = {
                    ...position,
                    heading,
                    distanceFromGcs: getDistanceKM(position.lat, position.lng, BASE_LAT, BASE_LON),
                    fovOverlapRatio: estimateFovOverlapRatio(position, heading, reservedFovs),
                    ...score
                };
                if (isBetterRelayPlan(candidate, best)) best = candidate;
            });
            return best;
        }

        function evaluateAndSteerADRFleet() {
            // These summaries contain only drones that have lost both direct and mesh
            // connectivity, plus direct links that are already critically degrading.
            const clusterSummaries = getClusterOperationalSummary();
            const edgeClusters = clusterSummaries;
            const allClustersBackInGcs = clusterSummaries.length === 0;
            const unassignedClusterIds = new Set(edgeClusters.map(c => c.id));
            const reservedFovs = []; // Accepted sectors from earlier ADR birds in this optimization cycle.

            adrFleet.forEach((bird, index) => {
                let selectedTargets = [];

                if (allClustersBackInGcs) {
                    bird.state = 'STANDBY';
                    bird.activeTargets = [];
                    bird.supportedNodes = 0;
                    bird.coverageAdequate = true;
                    bird.fovOverlapRatio = 0;
                    bird.fovOverlapPercent = 0;
                    bird.fovOverlapCompliant = true;

                    const standbyBearing = 90 + index * (360 / Math.max(adrFleet.length, 1));
                    const standbyPos = getPointAtDistanceAndBearing(BASE_LAT, BASE_LON, ADR_STANDBY_RADIUS_KM, standbyBearing);
                    bird.lat += (standbyPos.lat - bird.lat) * 0.10;
                    bird.lng += (standbyPos.lng - bird.lng) * 0.10;
                    bird.commandedHeading = standbyBearing;
                } else {
                    bird.state = 'ACTIVATED';
                    const availableClusters = edgeClusters.filter(c => unassignedClusterIds.has(c.id));
                    const planningClusters = availableClusters.length ? availableClusters : edgeClusters;
                    const relayPosition = findMaximumClusterRelayPlan(planningClusters, reservedFovs);
                    selectedTargets = relayPosition ? relayPosition.selectedClusters : [];
                    selectedTargets.forEach(target => unassignedClusterIds.delete(target.id));
                    bird.activeTargets = selectedTargets.map(t => t.id);

                    if (!relayPosition || selectedTargets.length === 0) {
                        bird.state = 'STANDBY';
                        bird.supportedNodes = 0;
                        bird.coverageAdequate = false;
                        return;
                    }

                    // Move independently to the best point in the GCS-centred movement area.
                    bird.lat += (relayPosition.lat - bird.lat) * ADR_POSITION_SMOOTHING;
                    bird.lng += (relayPosition.lng - bird.lng) * ADR_POSITION_SMOOTHING;

                    // Hard safety clamp: keep every ADR bird inside GCS communication range.
                    const distanceFromGcs = getDistanceKM(bird.lat, bird.lng, BASE_LAT, BASE_LON);
                    if (distanceFromGcs > GCS_RANGE_LIMIT_KM) {
                        const safeBearing = getBearing(BASE_LAT, BASE_LON, bird.lat, bird.lng);
                        const safePos = getPointAtDistanceAndBearing(BASE_LAT, BASE_LON, GCS_RANGE_LIMIT_KM, safeBearing);
                        bird.lat = safePos.lat;
                        bird.lng = safePos.lng;
                    }

                    // Re-optimize yaw at the bird's actual current position. This is the
                    // key correction for clusters near the left or right FOV boundary.
                    const localPlan = findBestHeadingAtCurrentPosition(
                        { lat: bird.lat, lng: bird.lng },
                        planningClusters,
                        reservedFovs
                    );
                    if (localPlan) {
                        selectedTargets = localPlan.supportedClusters.map(item => item.cluster);
                        if (!selectedTargets.length) selectedTargets = relayPosition.selectedClusters;
                        bird.activeTargets = selectedTargets.map(t => t.id);
                    }
                    const optimizedHeading = localPlan ? localPlan.heading : relayPosition.heading;
                    bird.commandedHeading = getAdrClusterFocusHeading(
                        bird,
                        selectedTargets,
                        optimizedHeading
                    );
                    bird.commandedRelayLat = relayPosition.lat;
                    bird.commandedRelayLng = relayPosition.lng;
                    bird.commandedCoverageRatio = planningClusters.length
                        ? selectedTargets.length / planningClusters.length
                        : 0;

                    let supportedNodes = 0;
                    selectedTargets.forEach(target => {
                        target.members.forEach(node => {
                            if (targetInsideAdrFov(bird, node.lat, node.lng)) supportedNodes++;
                        });
                    });
                    bird.supportedNodes = supportedNodes;
                    // A service group is supported when the required lost/weak members are
                    // simultaneously inside the ADR communication range and antenna FOV.
                    bird.supportedClusters = selectedTargets.filter(target => {
                        const nodesInsideFov = target.members.filter(node =>
                            targetInsideAdrFov(bird, node.lat, node.lng)
                        ).length;
                        const requiredNodes = Math.min(MIN_CLUSTER_NODES_IN_FOV, target.members.length);
                        return requiredNodes > 0 && nodesInsideFov >= requiredNodes;
                    }).length;
                    bird.maxQualifiedClusters = relayPosition.supportedClusterCount;
                    const adrToGcsDistance = getDistanceKM(bird.lat, bird.lng, BASE_LAT, BASE_LON);
                    bird.coverageAdequate = selectedTargets.length > 0 && selectedTargets.every(target => {
                        const nodesInsideFov = target.members.filter(node =>
                            targetInsideAdrFov(bird, node.lat, node.lng)
                        ).length;
                        const requiredNodes = Math.min(MIN_CLUSTER_NODES_IN_FOV, target.members.length);
                        return requiredNodes > 0 && nodesInsideFov >= requiredNodes;
                    }) && adrToGcsDistance <= GCS_RANGE_LIMIT_KM + 1e-9;

                    bird.fovOverlapRatio = estimateFovOverlapRatio(
                        { lat: bird.lat, lng: bird.lng },
                        bird.heading,
                        reservedFovs
                    );
                    bird.fovOverlapPercent = bird.fovOverlapRatio * 100;
                    bird.fovOverlapCompliant = bird.fovOverlapRatio <= MAX_ADR_FOV_OVERLAP_RATIO + 1e-9;
                    if (bird.supportedClusters > 0) {
                        bird.coverageAdequate = bird.coverageAdequate && bird.fovOverlapCompliant;
                    }
                    bird.state = bird.coverageAdequate ? 'RELAY_ACTIVE' : 'REPOSITIONING';

                    // Reserve this actual sector for the remaining ADR birds. Later birds
                    // must choose plans sharing no more than 10% of their sector area.
                    const reservedLocal = getLocalKm(bird.lat, bird.lng);
                    const reservedHeadingRad = bird.heading * Math.PI / 180;
                    reservedFovs.push({
                        birdId: bird.id,
                        lat: bird.lat,
                        lng: bird.lng,
                        heading: bird.heading,
                        localX: reservedLocal.x,
                        localY: reservedLocal.y,
                        forwardX: Math.sin(reservedHeadingRad),
                        forwardY: Math.cos(reservedHeadingRad)
                    });

                    selectedTargets.forEach(target => {
                        L.polyline([[bird.lat, bird.lng], [target.centroidLat, target.centroidLng]], {
                            color: bird.coverageAdequate ? '#2ecc71' : '#ff3333',
                            weight: 2.5,
                            dashArray: '5, 5',
                            interactive: false,
                            renderer: overlayRenderer
                        }).addTo(adrLayer);
                    });

                    const sectorPoints = getFovPolygonPoints(bird.lat, bird.lng, bird.heading, ADR_MAX_RANGE_KM, ADR_FOV_DEG);
                    const fovPolygon = L.polygon(sectorPoints, {
                        color: bird.coverageAdequate ? '#2ecc71' : '#f39c12',
                        weight: 1.5,
                        fillColor: bird.coverageAdequate ? '#2ecc71' : '#f39c12',
                        fillOpacity: 0.12,
                        dashArray: '3, 3',
                        interactive: false,
                        renderer: overlayRenderer
                    }).addTo(adrLayer);
                    adrFovPolygons.set(bird.id, fovPolygon);

                    const headingEnd = getPointAtDistanceAndBearing(
                        bird.lat,
                        bird.lng,
                        ADR_MAX_RANGE_KM,
                        bird.heading
                    );
                    const headingLine = L.polyline([
                        [bird.lat, bird.lng],
                        [headingEnd.lat, headingEnd.lng]
                    ], {
                        color: '#2ecc71',
                        weight: 2.5,
                        opacity: 0.95,
                        interactive: false,
                        renderer: overlayRenderer
                    }).addTo(adrLayer);
                    adrHeadingLines.set(bird.id, headingLine);
                }

                const distToGcsNow = getDistanceKM(bird.lat, bird.lng, BASE_LAT, BASE_LON);
                bird.rssi_dbm = -50.0 - 10 * 3.8 * Math.log10(Math.max(distToGcsNow, 0.1));

                L.polyline([[BASE_LAT, BASE_LON], [bird.lat, bird.lng]], {
                    color: '#90ee90', weight: 1.5, dashArray: '2, 6', opacity: 0.75, interactive: false, renderer: overlayRenderer
                }).addTo(adrLayer);

                const adrMarker = L.marker([bird.lat, bird.lng], {
                    icon: createAdrMarkerIcon(bird)
                }).bindPopup(
                    `<b>${bird.id}</b><br>` +
                    `State: ${bird.state}<br>` +
                    `Targets: ${bird.activeTargets.length ? bird.activeTargets.join(', ') : 'None'}<br>` +
                    `Qualified clusters (>=${MIN_CLUSTER_NODES_IN_FOV} drones): ${bird.supportedClusters || 0}<br>` +
                    `Supported nodes: ${bird.supportedNodes}`
                ).addTo(adrLayer);
                adrMarkers.set(bird.id, adrMarker);
            });
        }

        function updateSummaryDataBoxes(force = false) {
            const now = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
            if (!force && now - lastSummaryUpdateAt < SUMMARY_UPDATE_INTERVAL_MS) {
                return;
            }
            lastSummaryUpdateAt = now;

            const container = document.getElementById('cluster-info');
            container.innerHTML = '';
            const clusterMap = new Map();
            dronesData.forEach(drone => {
                if (drone.cluster === -1) return;
                if (!clusterMap.has(drone.cluster)) clusterMap.set(drone.cluster, []);
                clusterMap.get(drone.cluster).push(drone);
            });
            let clustersInSwarm = [...clusterMap.entries()].sort((a,b) => a[0] - b[0]);

            clustersInSwarm.forEach(([cId, subNodes]) => {
                let avgDist = subNodes.reduce((acc, curr) => acc + curr.dist_home_km, 0) / subNodes.length;
                let avgRSSI = subNodes.reduce((acc, curr) => acc + curr.rssi_dbm, 0) / subNodes.length;
                
                // 1. Check for Direct GCS Contact
                let hasNodeInGcsRange = subNodes.some(d => getDistanceKM(BASE_LAT, BASE_LON, d.lat, d.lng) <= GCS_RANGE_LIMIT_KM);
                
                // 2. Check for ADR Relay Contact (FOV Logic)
                let hasNodeInAdrFov = subNodes.some(d => {
                    return adrFleet.some(adr => {
                        let dist = getDistanceKM(adr.lat, adr.lng, d.lat, d.lng);
                        if (dist > ADR_MAX_RANGE_KM) return false; // Must be within ADR Max Range
                        
                        let bearing = getBearing(adr.lat, adr.lng, d.lat, d.lng);
                        let angleDiff = Math.abs((bearing - adr.heading + 540) % 360 - 180);
                        
                        return angleDiff <= (ADR_FOV_DEG / 2); // Must be inside the cone angle
                    });
                });

                // 3. Assign appropriate label based on contact type
                let rangeLabel = hasNodeInGcsRange ? "🔗 MESH CONNECTED TO GCS" : 
                                 (hasNodeInAdrFov ? "🔗 MESH CONNECTED TO GCS (VIA ADR)" : 
                                 (avgDist > GCS_RANGE_LIMIT_KM ? "🚫 OUTSIDE GCS" : "🏠 INSIDE GCS"));
                                 
                let color = clusterColors[cId] || '#1abc9c';
                let label = cId === -1 ? "Noise Components / Outliers" : `Swarm Network Cluster ${cId}`;

                const box = document.createElement('div');
                box.className = 'cluster-item';
                box.style.borderLeft = `4px solid ${color}`;
                box.innerHTML = `
                    <strong style="color:${color};">${label}</strong> (${subNodes.length} units)<br>
                    Centroid to GCS: ${avgDist.toFixed(1)} km [<b>${rangeLabel}</b>]<br>
                    Mean Attenuation RSSI: ${avgRSSI.toFixed(1)} dBm
                `;
                container.appendChild(box);
            });
        }

