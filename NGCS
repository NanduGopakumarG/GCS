        function startAllMissions() {
            let changed = false;
            dronesData.forEach(drone => {
                const mission = drone.mission;
                if (!mission || mission.completed) {
                    if (startNextMissionRole(drone)) changed = true;
                    return;
                }
                mission.active = true;
                mission.paused = false;
                mission.stoppedByOperator = false;
                changed = true;
            });
            if (changed) drawStaticNetworkVisuals(true);
        }

        function pauseAllMissions() {
            let changed = false;
            dronesData.forEach(drone => {
                const mission = drone.mission;
                if (!mission || !mission.active || mission.completed) return;
                mission.paused = true;
                changed = true;
            });
            if (changed) drawStaticNetworkVisuals(true);
        }

        function stopAllMissions() {
            let changed = false;
            dronesData.forEach(drone => {
                const mission = drone.mission;
                if (Array.isArray(drone.missionQueue) && drone.missionQueue.length) {
                    drone.missionQueue = [];
                    changed = true;
                }
                if (!mission || mission.completed || (!mission.active && mission.stoppedByOperator)) return;
                mission.active = false;
                mission.paused = false;
                mission.stoppedByOperator = true;
                changed = true;
            });
            if (changed) drawStaticNetworkVisuals(true);
        }

