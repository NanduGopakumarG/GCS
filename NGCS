            document.getElementById('mission-target-prompt').style.display = 'none';
            map.getContainer().style.cursor = '';
            if (showComposer) document.getElementById('mission-builder-panel').style.display = 'block';
        }

        function resetRoleGeometryForPlan(card) {
            const type = card.querySelector('.role-plan').value;
            const center = map.getCenter();
            if (type === 'waypoint') {
                card.querySelector('.role-waypoints').value = '';
                card.querySelector('.role-location-status').innerText = 'Waypoints: click map to add the first point';
            } else {
                card.querySelector('.role-latitude').value = center.lat.toFixed(6);
                card.querySelector('.role-longitude').value = center.lng.toFixed(6);
                card.querySelector('.role-location-status').innerText = `Target: ${center.lat.toFixed(6)}, ${center.lng.toFixed(6)}`;
            }
        }

        function applyMissionRoleMapLocation(latlng) {
            const card = activeMissionRolePickerCard;
            if (!card || !document.body.contains(card)) {
                deactivateMissionRoleMapSelection(false);
                return;
            }

            const type = card.querySelector('.role-plan').value;
            if (type === 'waypoint') {
                const textarea = card.querySelector('.role-waypoints');
                const point = `${latlng.lat.toFixed(6)}, ${latlng.lng.toFixed(6)}`;
                const existing = textarea.value.trim();
                textarea.value = existing ? `${existing}\n${point}` : point;
                const count = textarea.value.split(/\n+/).filter(Boolean).length;
                card.querySelector('.role-location-status').innerText = `${count} waypoint${count === 1 ? '' : 's'} selected`;
                renderMissionRolePreviews();
                return;
            }

            card.querySelector('.role-latitude').value = latlng.lat.toFixed(6);
            card.querySelector('.role-longitude').value = latlng.lng.toFixed(6);
            card.querySelector('.role-location-status').innerText = `Target: ${latlng.lat.toFixed(6)}, ${latlng.lng.toFixed(6)}`;
            renderMissionRolePreviews();
            deactivateMissionRoleMapSelection(true);
        }

        function getRolePreviewColor(roleIndex) {
            const colors = ['#d2b4de', '#5dade2', '#58d68d', '#f5b041', '#ec7063', '#48c9b0'];
            return colors[roleIndex % colors.length];
        }

        function parseRoleSurveyPoints(card) {
            const field = card.querySelector('.role-survey-points');
            if (!field) return [];
            return field.value.split(/[;\n]+/).map(line => line.trim()).filter(Boolean)
                .map(line => line.split(/[,\s]+/).filter(Boolean).map(Number))
                .filter(values => values.length === 2 && values.every(Number.isFinite))
                .map(([lat, lng]) => ({ lat, lng }));
        }

        function parseRolePreviewWaypoints(card) {
            return card.querySelector('.role-waypoints').value
                .split(/[;\n]+/)
                .map(line => line.trim())
                .filter(Boolean)
                .map(line => line.split(/[,\s]+/).filter(Boolean).map(Number))
                .filter(values => values.length === 2 && values.every(Number.isFinite))
                .map(([lat, lng]) => ({ lat, lng }));
        }

        function renderMissionRolePreviews() {
            if (!missionRolePreviewLayer) return;
            missionRolePreviewLayer.clearLayers();
            [...document.querySelectorAll('.mission-role-card')].forEach((card, index) => {
                const type = card.querySelector('.role-plan').value;
                if (!type) return;
                const roleId = card.dataset.roleId;
                const color = getRolePreviewColor(index);
                const labelIcon = text => L.divIcon({
                    className: '',
                    html: `<div style="padding:3px 6px;border:1px solid ${color};border-radius:10px;background:rgba(20,20,20,.92);color:${color};font:700 10px monospace;white-space:nowrap;">${text}</div>`,
                    iconSize: [90, 22],
                    iconAnchor: [45, 11]
                });

                if (type === 'waypoint') {
                    const points = parseRolePreviewWaypoints(card);
                    if (!points.length) return;
                    if (points.length > 1) L.polyline(points, { color, weight: 3, dashArray: '7,5', renderer: overlayRenderer }).addTo(missionRolePreviewLayer);
                    points.forEach((point, pointIndex) => {
                        L.circleMarker(point, { radius: 6, color, weight: 2, fillColor: '#121212', fillOpacity: 1, renderer: overlayRenderer })
                            .bindTooltip(`ROLE ${roleId} · WP ${pointIndex + 1}`, { permanent: true, direction: 'top', className: 'drone-marker-label' })
                            .addTo(missionRolePreviewLayer);
                    });
                    return;
                }

                const lat = Number(card.querySelector('.role-latitude').value);
                const lng = Number(card.querySelector('.role-longitude').value);
                if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
                const center = { lat, lng };
                if (type === 'goto') {
                    L.circleMarker(center, {
                        radius: 6, fillColor: '#ff2d2d', color: '#fff', weight: 2,
                        fillOpacity: 1, interactive: false, renderer: overlayRenderer
                    }).bindTooltip(`ROLE ${roleId} · GO TO`, {
                        permanent: true, direction: 'top', className: 'drone-marker-label'
                    }).addTo(missionRolePreviewLayer);
                } else {
                    L.marker(center, { icon: labelIcon(`ROLE ${roleId} · ${type.toUpperCase()}`), interactive: false }).addTo(missionRolePreviewLayer);
                }

                if (type === 'orbit') {
                    const radiusKm = Number(card.querySelector('.role-orbit-radius').value) || 1;
                    L.circle(center, { radius: radiusKm * 1000, color, weight: 2, fillColor: color, fillOpacity: 0.08, renderer: overlayRenderer }).addTo(missionRolePreviewLayer);
                } else if (type === 'survey') {
                    const shape = card.querySelector('.role-survey-shape').value;
                    const sizeKm = Number(card.querySelector('.role-survey-size').value) || 2;
                    const boundary = shape === 'custom'
                        ? parseRoleSurveyPoints(card)
                        : buildMissionRoleSurveyBoundary(center, shape, sizeKm);
                    if (boundary.length < 3) return;
                    L.polygon(boundary, { color, weight: 2, fillColor: color, fillOpacity: 0.08, renderer: overlayRenderer }).addTo(missionRolePreviewLayer);
                    const spacing = Number(card.querySelector('.role-survey-spacing').value) || 0.5;
                    const path = buildSurveyCoveragePath(boundary, spacing);
                    if (path.length > 1) L.polyline(path, { color, weight: 2, opacity: 0.8, dashArray: '5,5', renderer: overlayRenderer }).addTo(missionRolePreviewLayer);
                }
            });
        }

        window.addEventListener('keydown', event => {
