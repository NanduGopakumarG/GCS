        function runDBSCANClustering(nodes, epsMetres, minPts = 2) {
            const total = nodes.length;
            const labels = new Int32Array(total);
            labels.fill(-1);
            const visited = new Uint8Array(total);
            const positions = nodes.map(n => convertGPSToLocalMetres(n.lat, n.lng));
            const grid = new Map();
            const cellKey = (x, y) => `${x},${y}`;

            // Spatial hashing limits neighbor checks to the current cell and its
            // eight neighbors instead of scanning every drone for every query.
            positions.forEach((point, index) => {
                const cellX = Math.floor(point.x / epsMetres);
                const cellY = Math.floor(point.y / epsMetres);
                const key = cellKey(cellX, cellY);
                if (!grid.has(key)) grid.set(key, []);
                grid.get(key).push(index);
            });

            function getNeighbors(index) {
                const point = positions[index];
                const cellX = Math.floor(point.x / epsMetres);
                const cellY = Math.floor(point.y / epsMetres);
                const neighbors = [];
                const epsSquared = epsMetres * epsMetres;
                for (let dx = -1; dx <= 1; dx++) {
                    for (let dy = -1; dy <= 1; dy++) {
                        const bucket = grid.get(cellKey(cellX + dx, cellY + dy));
                        if (!bucket) continue;
                        bucket.forEach(candidate => {
                            const deltaX = point.x - positions[candidate].x;
                            const deltaY = point.y - positions[candidate].y;
                            if (deltaX * deltaX + deltaY * deltaY <= epsSquared) neighbors.push(candidate);
                        });
                    }
                }
                return neighbors;
            }

            let clusterId = 0;
            for (let i = 0; i < total; i++) {
                if (visited[i]) continue;
                visited[i] = 1;
                const neighbors = getNeighbors(i);
                if (neighbors.length < minPts) continue;

                labels[i] = clusterId;
                const queued = new Uint8Array(total);
                const queue = [];
                neighbors.forEach(index => {
                    if (!queued[index]) { queued[index] = 1; queue.push(index); }
                });

                for (let cursor = 0; cursor < queue.length; cursor++) {
                    const currentIdx = queue[cursor];
                    if (!visited[currentIdx]) {
                        visited[currentIdx] = 1;
                        const nextNeighbors = getNeighbors(currentIdx);
                        if (nextNeighbors.length >= minPts) {
                            nextNeighbors.forEach(index => {
                                if (!queued[index]) { queued[index] = 1; queue.push(index); }
                            });
                        }
                    }
                    if (labels[currentIdx] === -1) labels[currentIdx] = clusterId;
                }
                clusterId++;
            }
            for (let i = 0; i < total; i++) nodes[i].cluster = labels[i];
        }

        function processCoreDroneData() {
            dronesData.forEach(drone => {
                const homeLat = isFlyMode && Number.isFinite(drone.homeLat) ? drone.homeLat : BASE_LAT;
