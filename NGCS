        function startMission() {
            const velocity = Math.max(1, parseFloat(document.getElementById('mission-velocity').value) || 100);
            const armingTimeSec = Math.max(0.1, parseFloat(document.getElementById('mission-arming-time').value) || 5);
            const takeoffAltitude = Math.max(1, parseFloat(document.getElementById('mission-takeoff-altitude').value) || 50);
            const landingTimeSec = Math.max(0.1, parseFloat(document.getElementById('mission-landing-time').value) || 5);
            const orbitRadius = parseFloat(document.getElementById('mission-orbit-radius').value) || 1.0;
            const type = document.getElementById('mission-type-hidden').value;
            const hoverAtDestination = type === 'goto' && document.getElementById('mission-goto-hover').checked;

            const checkedDrones = getCheckedDroneIds(
                document.getElementById('mission-target-drone-list'),
                'mission-target-drone-checkbox'
            );

            if (checkedDrones.length === 0) {
                document.getElementById('mission-target-selection-error').style.display = 'block';
                return;
            }
            document.getElementById('mission-target-selection-error').style.display = 'none';

            if (type === 'waypoint' && waypointPlan.length < 2) {
                alert("Please create a path with at least two waypoints.");
                return;
            }
            if (type === 'survey' && !document.getElementById('survey-shape-select').value) {
                alert("Please select a survey shape.");
                return;
            }
            if (type === 'survey' && waypointPlan.length < 3) {
                alert("Please create a survey area with at least three points.");
                return;
            }

            const surveySpacingKm = Math.max(
                0.05,
                parseFloat(document.getElementById('survey-pass-spacing').value) || 0.5
            );
            const surveyLoopCount = Math.floor(
                Math.max(1, Math.min(100, parseFloat(document.getElementById('survey-loop-count').value) || 1))
            );
            const route = type === 'survey'
                ? buildSurveyCoveragePath(waypointPlan, surveySpacingKm)
                : waypointPlan.map(point => ({ lat: point.lat, lng: point.lng }));
            if (type === 'survey' && route.length < 2) {
                alert("The selected area is too small for the current pass spacing. Reduce the pass spacing and try again.");
                return;
            }

            if (editingMissionRoleCard) {
                const roleCard = editingMissionRoleCard;
                saveMissionPanelToRole(roleCard);
                editingMissionRoleCard = null;
                closeMissionPanel(false);
                document.getElementById('mission-builder-panel').style.display = 'block';
                renderMissionRolePreviews();
                return;
            }

            checkedDrones.forEach((droneId, selectedDroneIndex) => {
                const drone = droneById.get(droneId);
                if (drone && contextMenuTarget) {
                    const mission = {
                        type: type,
                        target: { lat: contextMenuTarget.lat, lng: contextMenuTarget.lng },
                        velocity: velocity,
                        radius: orbitRadius,
                        active: true,
                        paused: false,
                        completed: false,
                        stoppedByOperator: false,
                        loop: false,
                        inOrbit: false,
                        phase: drone.armed ? 'takeoff' : 'arming',
                        phaseElapsedSec: 0,
                        armingTimeSec: armingTimeSec,
                        takeoffAltitude: takeoffAltitude,
                        landingTimeSec: landingTimeSec,
                        landingStartAltitude: null,
                        hoverAtDestination: hoverAtDestination
                    };
                    if (type === 'waypoint' || type === 'survey') {
                        mission.waypoints = type === 'survey'
                            ? splitSurveyWaypointsForDrone(route, selectedDroneIndex, checkedDrones.length)
                            : route.map(point => ({ ...point }));
                        if (type === 'survey') {
                            mission.surveyTeamSize = checkedDrones.length;
                            mission.surveySectionIndex = selectedDroneIndex + 1;
                            mission.surveyShape = document.getElementById('survey-shape-select').value;
                            mission.surveyBoundary = waypointPlan.map(point => ({ ...point }));
                            mission.passSpacingKm = surveySpacingKm;
                            mission.surveyLoopCount = surveyLoopCount;
                            mission.completedSurveyLoops = 0;
                        }
                        mission.waypointIndex = 0;
                        mission.target = { ...mission.waypoints[0] };
                    }
                    if (drone.altitude <= 0.1 || !Number.isFinite(drone.launchLat) || !Number.isFinite(drone.launchLng)) {
                        drone.launchLat = drone.lat;
                        drone.launchLng = drone.lng;
                    }
                    
                    // Check if drone is already in an active mission
                    if (isDroneMissionBusy(drone)) {
                        // Stop current mission and immediately start new one
                        stopDroneMission(drone);
                        activateMissionRole(drone, mission);
                        resetDroneFlightTrack(drone);
                        console.log(`[MISSION] Drone ${droneId}: Current mission interrupted. New mission assigned.`);
                    } else {
                        // Drone is idle, use normal mission queue
                        const missionStartedNow = enqueueMissionForDrone(drone, mission);
                        if (missionStartedNow) {
                            drone.rtlAction = null;
                            drone.rthAction = null;
                            drone.verticalAction = null;
                            drone.velocity = velocity;
                            drone.flightState = drone.armed ? 'TAKING OFF' : 'ARMING';
                            resetDroneFlightTrack(drone);
                        }
                    }
                }
            });

            selectedDrones.clear();
            updateSelectionVisuals();
            closeMissionPanel();
            drawStaticNetworkVisuals(true); 
        }

