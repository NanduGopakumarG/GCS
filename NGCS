        }

        function showMissionBuilderError(message) {
            const error = document.getElementById('mission-builder-error');
            error.innerText = message;
            error.style.display = 'block';
            error.scrollIntoView({ block: 'nearest' });
        }

        function parseMissionRoleWaypoints(text, roleNumber) {
            const points = text.split(/[;\n]+/).map(line => line.trim()).filter(Boolean).map(line => {
                const values = line.split(/[,\s]+/).filter(Boolean).map(Number);
                return { lat: values[0], lng: values[1], valid: values.length === 2 };
            });
            if (points.length < 2 || points.some(point =>
                !point.valid || !Number.isFinite(point.lat) || !Number.isFinite(point.lng) ||
                point.lat < -90 || point.lat > 90 || point.lng < -180 || point.lng > 180
            )) {
                throw new Error(`Role ${roleNumber}: enter at least two valid waypoint coordinate pairs.`);
            }
            return points.map(({ lat, lng }) => ({ lat, lng }));
        }

        function buildMissionRoleSurveyBoundary(center, shape, sizeKm) {
            const pointCount = { triangle: 3, square: 4, polygon: 6, circle: 36 }[shape] || 6;
            const rotationDeg = shape === 'square' ? 45 : 0;
            return Array.from({ length: pointCount }, (_, index) =>
                getPointAtDistanceAndBearing(center.lat, center.lng, sizeKm, rotationDeg + index * 360 / pointCount)
            );
        }

        function readMissionRole(card, roleNumber, missionName) {
            const selectedIds = getCheckedDroneIds(card, 'role-drone-checkbox');
            const assignedDrones = selectedIds.map(id => droneById.get(id)).filter(Boolean);
            if (!assignedDrones.length) throw new Error(`Role ${roleNumber}: select at least one drone ID.`);
            const type = card.querySelector('.role-plan').value;
            if (!type) throw new Error(`Role ${roleNumber}: select a plan.`);
            const altitude = Number(card.querySelector('.role-altitude').value);
            const velocity = Number(card.querySelector('.role-velocity').value);
            if (!Number.isFinite(altitude) || altitude < 1 || altitude > 5000)
                throw new Error(`Role ${roleNumber}: altitude must be from 1 to 5000 m.`);
            if (!Number.isFinite(velocity) || velocity < 1 || velocity > 500)
                throw new Error(`Role ${roleNumber}: velocity must be from 1 to 500 m/s.`);

            const mission = {
                missionName,
                roleNumber,
                type,
                velocity,
                active: false,
                paused: false,
                completed: false,
                stoppedByOperator: false,
                loop: false,
                inOrbit: false,
                phaseElapsedSec: 0,
                armingTimeSec: 5,
                takeoffAltitude: altitude,
                landingTimeSec: 5,
                landingStartAltitude: null,
                hoverAtDestination: type === 'goto' && card.querySelector('.role-hover').checked
            };

            if (type === 'waypoint') {
                mission.waypoints = parseMissionRoleWaypoints(card.querySelector('.role-waypoints').value, roleNumber);
                mission.waypointIndex = 0;
                mission.target = { ...mission.waypoints[0] };
            } else {
                const lat = Number(card.querySelector('.role-latitude').value);
                const lng = Number(card.querySelector('.role-longitude').value);
                if (!Number.isFinite(lat) || !Number.isFinite(lng) || lat < -90 || lat > 90 || lng < -180 || lng > 180)
                    throw new Error(`Role ${roleNumber}: enter valid target coordinates.`);
                mission.target = { lat, lng };

                if (type === 'orbit') {
                    mission.radius = Number(card.querySelector('.role-orbit-radius').value);
                    mission.orbitLoops = Math.floor(Number(card.querySelector('.role-orbit-loops').value));
                    mission.orbitTravelDeg = 0;
                    if (!Number.isFinite(mission.radius) || mission.radius < 0.1 || mission.radius > 15)
                        throw new Error(`Role ${roleNumber}: orbit radius must be from 0.1 to 15 km.`);
                    if (!Number.isFinite(mission.orbitLoops) || mission.orbitLoops < 1 || mission.orbitLoops > 100)
                        throw new Error(`Role ${roleNumber}: orbit loops must be from 1 to 100.`);
                } else if (type === 'survey') {
                    const shape = card.querySelector('.role-survey-shape').value;
                    if (!shape) throw new Error(`Role ${roleNumber}: select a survey shape.`);
                    const sizeKm = Number(card.querySelector('.role-survey-size').value);
                    const spacingKm = Number(card.querySelector('.role-survey-spacing').value);
                    const surveyLoops = Math.floor(Number(card.querySelector('.role-survey-loops').value));
                    if (!Number.isFinite(sizeKm) || sizeKm < 0.1 || sizeKm > 25)
                        throw new Error(`Role ${roleNumber}: survey size must be from 0.1 to 25 km.`);
                    if (!Number.isFinite(spacingKm) || spacingKm < 0.05 || spacingKm > 10)
                        throw new Error(`Role ${roleNumber}: survey spacing must be from 0.05 to 10 km.`);
                    if (!Number.isFinite(surveyLoops) || surveyLoops < 1 || surveyLoops > 100)
                        throw new Error(`Role ${roleNumber}: survey loop count must be from 1 to 100.`);
                    mission.surveyShape = shape;
                    mission.surveyLoopCount = surveyLoops;
                    mission.completedSurveyLoops = 0;
                    mission.passSpacingKm = spacingKm;
                    mission.surveyBoundary = shape === 'custom'
                        ? parseRoleSurveyPoints(card)
                        : buildMissionRoleSurveyBoundary(mission.target, shape, sizeKm);
                    if (mission.surveyBoundary.length < 3)
                        throw new Error(`Role ${roleNumber}: mark at least three custom survey points.`);
                    mission.waypoints = buildSurveyCoveragePath(mission.surveyBoundary, spacingKm);
                    if (mission.waypoints.length < 2)
                        throw new Error(`Role ${roleNumber}: reduce survey spacing or increase area size.`);
                    mission.waypointIndex = 0;
                    mission.target = { ...mission.waypoints[0] };
                }
            }
            return { drones: assignedDrones, mission };
        }

        function activateMissionRole(drone, mission) {
            mission.active = true;
            mission.paused = false;
            mission.completed = false;
            mission.stoppedByOperator = false;
            mission.phase = drone.armed ? 'takeoff' : 'arming';
            mission.phaseElapsedSec = 0;
            mission.landingStartAltitude = null;
            mission.waypointIndex = mission.waypoints ? 0 : mission.waypointIndex;
            if (mission.waypoints?.length) mission.target = { ...mission.waypoints[0] };
            if (drone.altitude <= 0.1 || !Number.isFinite(drone.launchLat) || !Number.isFinite(drone.launchLng)) {
                drone.launchLat = drone.lat;
                drone.launchLng = drone.lng;
            }
            drone.rtlAction = null;
            drone.rthAction = null;
            drone.verticalAction = null;
            drone.velocity = mission.velocity;
            drone.flightState = drone.armed ? 'TAKING OFF' : 'ARMING';
            drone.mission = mission;
        }

        function startNextMissionRole(drone) {
            if (!Array.isArray(drone.missionQueue) || drone.missionQueue.length === 0) return false;
            activateMissionRole(drone, drone.missionQueue.shift());
            return true;
        }

        function stopDroneMission(drone) {
            if (!drone || !drone.mission) return;
            
            // Mark current mission as stopped by operator
            drone.mission.active = false;
            drone.mission.completed = true;
            drone.mission.stoppedByOperator = true;
            
            // Clear the mission queue to prevent queued missions from starting
            drone.missionQueue = [];
            
            // Reset flight actions
            drone.rtlAction = null;
            drone.rthAction = null;
            drone.verticalAction = null;
        }

        function isDroneMissionBusy(drone) {
            const mission = drone?.mission;
            return Boolean(
                mission &&
                !mission.completed &&
                !mission.stoppedByOperator &&
                (mission.active || mission.paused)
            );
        }

        function enqueueMissionForDrone(drone, mission, options = {}) {
            if (!drone || !mission) return false;
            if (!Array.isArray(drone.missionQueue)) drone.missionQueue = [];

            const startImmediately = options.startImmediately !== false;
            const missionCopy = JSON.parse(JSON.stringify(mission));

            if (isDroneMissionBusy(drone) || !startImmediately) {
                drone.missionQueue.push(missionCopy);
                return false;
            }

            activateMissionRole(drone, missionCopy);
            return true;
        }

        function executeComposedMission() {
            const cards = [...document.querySelectorAll('.mission-role-card')];
            if (!cards.length) {
                showMissionBuilderError('Add at least one role to the mission.');
                return;
            }
            const missionName = document.getElementById('composed-mission-name').value.trim() || 'Multi-plan Mission';
            let roles;
            try {
                roles = cards.map((card, index) => readMissionRole(card, index + 1, missionName));
            } catch (error) {
                showMissionBuilderError(error.message);
                return;
            }

            const rolesByDrone = new Map();
            roles.forEach(role => {
                role.drones.forEach((drone, droneIndex) => {
                    if (!rolesByDrone.has(drone.id)) rolesByDrone.set(drone.id, []);
                    const droneMission = JSON.parse(JSON.stringify(role.mission));
                    if (droneMission.type === 'survey' && droneMission.waypoints?.length) {
                        droneMission.waypoints = splitSurveyWaypointsForDrone(
                            droneMission.waypoints,
                            droneIndex,
                            role.drones.length
                        );
                        droneMission.surveyTeamSize = role.drones.length;
                        droneMission.surveySectionIndex = droneIndex + 1;
                        droneMission.waypointIndex = 0;
                        droneMission.target = { ...droneMission.waypoints[0] };
                    }
                    rolesByDrone.get(drone.id).push(droneMission);
                });
            });
            rolesByDrone.forEach((missions, droneId) => {
                const drone = droneById.get(droneId);
                if (!drone) return;

                // Do not overwrite a mission that is already active. Free drones begin
                // their first new role immediately; busy drones receive all new roles
                // in their queue. This allows several mission submissions to coexist.
                missions.forEach((mission, missionIndex) => {
                    const startedNow = enqueueMissionForDrone(drone, mission, {
                        startImmediately: missionIndex === 0
                    });
                    if (startedNow) resetDroneFlightTrack(drone);
                });
            });
            selectedDrones.clear();
            updateSelectionVisuals();
            closeMissionBuilder();
            drawStaticNetworkVisuals(true);
        }

        function applyFlyFleetSize() {
            const input = document.getElementById('fly-drone-count');
            const requestedCount = parseInt(input.value, 10);
            const count = Math.max(1, Math.min(500, Number.isFinite(requestedCount) ? requestedCount : 1));
            input.value = count;
            document.getElementById('total-drones').value = count;
            generateSwarmArray();
        }

        function setFlySwarmMode(enabled) {
            isFlySwarmEnabled = Boolean(enabled);
            const checkbox = document.getElementById('fly-swarm-enabled');
            if (checkbox) checkbox.checked = isFlySwarmEnabled;
            if (!isFlyMode) return;

            if (!isFlySwarmEnabled) {
                dronesData.forEach(drone => { drone.cluster = -1; });
                meshLayer.clearLayers();
                meshLines.clear();
            }
            drawStaticNetworkVisuals(true);
            updateSystemMapLegend(true);
            updateFlyTelemetryPanel(true);
        }

        function setFlightMode(enabled) {
            const wasFlyMode = isFlyMode;
            isFlyMode = enabled;
            document.body.classList.toggle('fly-mode', enabled);
            const switchButton = document.getElementById('flight-mode-switch');
            switchButton.classList.toggle('active', enabled);
            switchButton.innerText = enabled ? 'ADR' : 'FLY';
            const homeButton = document.getElementById('home-position-button');
            if (homeButton) {
                const homeLabel = enabled ? 'Set drone home position' : 'Set GCS home location';
                homeButton.title = homeLabel;
                homeButton.setAttribute('aria-label', homeLabel);
            }

            if (enabled) {
                if (!wasFlyMode) {
                    dronesData.forEach(drone => {
                        if (!drone.armed && !drone.verticalAction) {
                            drone.altitude = 0;
                            drone.flightState = 'DISARMED';
                        }
                    });
                }
                if (isGcsSelectionMode) closeGcsPanel();
                if (map.hasLayer(gcsLayer)) map.removeLayer(gcsLayer);
                if (map.hasLayer(adrLayer)) map.removeLayer(adrLayer);
                adrLayer.clearLayers();
                const flyCountInput = document.getElementById('fly-drone-count');
                flyCountInput.value = Math.max(1, dronesData.length || 1);
                document.getElementById('fly-swarm-enabled').checked = isFlySwarmEnabled;
                populateFlyTelemetryDropdown();
                updateFlyTelemetryPanel(true);
            } else {
                closeFlightActionPanel();
                if (!map.hasLayer(gcsLayer)) gcsLayer.addTo(map);
                if (!map.hasLayer(adrLayer)) adrLayer.addTo(map);
                setupBaseAssets();
            }

            drawStaticNetworkVisuals(true);
            updateSystemMapLegend(true);
            requestAnimationFrame(() => map.invalidateSize({ animate: false }));
        }

        function toggleFlightMode() {
            setFlightMode(!isFlyMode);
        }

        function getMissionQueueLabel(drone) {
            const queued = Array.isArray(drone?.missionQueue) ? drone.missionQueue.length : 0;
            return queued > 0 ? ` · ${queued} QUEUED` : '';
        }

        function getDroneFlightState(drone) {
            if (drone.rthAction) {
                const rthStates = {
                    arming: 'ARMING',
                    takeoff: 'TAKING OFF',
                    returning: 'RETURNING HOME',
                    landing: 'LANDING'
                };
                return rthStates[drone.rthAction.phase] || 'RETURNING HOME';
            }
            if (drone.rtlAction) return 'RETURNING TO LAUNCH';
            if (drone.verticalAction?.type === 'takeoff') return 'TAKING OFF';
            if (drone.verticalAction?.type === 'land') return 'LANDING';
            if (drone.flightState) return drone.flightState;
            return drone.armed ? 'ARMED' : 'DISARMED';
        }

        function openFlightActionPanel(action) {
            if (!isFlyMode) return;
            pendingFlightAction = action;
            if (isGcsSelectionMode) closeGcsPanel();
            if (document.getElementById('mission-setup-panel').style.display === 'block') closeMissionPanel();
            closeMissionBuilder();
            document.querySelector('.mission-quick-menu').style.display = 'none';
            document.getElementById('map-context-menu').style.display = 'none';

            const config = {
                arm: {
                    title: 'Arm Drones',
                    description: 'Select the drone IDs to arm before takeoff.',
                    confirm: 'ARM'
                },
                takeoff: {
                    title: 'Takeoff Drones',
                    description: 'Select armed drones and enter their target altitude.',
                    confirm: 'TAKEOFF'
                },
                land: {
                    title: 'Land Drones',
                    description: 'Select drones to land vertically at their current map position.',
                    confirm: 'LAND'
                },
                rtl: {
                    title: 'Return to Launch',
                    description: 'Select armed drones to return to their recorded launch position and land automatically.',
                    confirm: 'RTL'
                },
                rth: {
                    title: 'Return to Home',
                    description: 'Select drones to arm, take off, return to Home, land, and disarm automatically.',
                    confirm: 'RTH'
                }
            }[action];
            if (!config) return;

            document.getElementById('flight-action-title').innerText = config.title;
            document.getElementById('flight-action-description').innerText = config.description;
            document.getElementById('confirm-flight-action').innerText = config.confirm;
            document.getElementById('takeoff-altitude-container').style.display = action === 'takeoff' || action === 'rth' ? 'flex' : 'none';
            document.getElementById('flight-action-velocity-container').style.display = action === 'rth' ? 'flex' : 'none';
            document.getElementById('flight-action-error').style.display = 'none';

            const list = document.getElementById('flight-action-drone-list');
            list.innerHTML = '';
            dronesData.forEach(drone => {
                const label = document.createElement('label');
                label.className = 'checkbox-item';
                const checked = selectedDrones.has(drone.id) ? 'checked' : '';
                label.innerHTML = `<input type="checkbox" class="flight-action-drone-checkbox" value="${drone.id}" ${checked}> ${drone.id} — ${getDroneFlightState(drone)}`;
                list.appendChild(label);
            });
            document.getElementById('flight-action-panel').style.display = 'block';
        }

        function closeFlightActionPanel() {
            const panel = document.getElementById('flight-action-panel');
            if (panel) panel.style.display = 'none';
            pendingFlightAction = null;
        }

        function showFlightActionError(message) {
            const error = document.getElementById('flight-action-error');
            error.innerText = message;
            error.style.display = 'block';
        }

        function confirmFlightAction() {
            const selectedIds = [...document.querySelectorAll('.flight-action-drone-checkbox:checked')]
                .map(input => input.value);
            if (selectedIds.length === 0) {
                showFlightActionError('Select at least one drone ID.');
                return;
            }
            const drones = selectedIds.map(id => droneById.get(id)).filter(Boolean);
            drones.forEach(resetDroneFlightTrack);

            if (pendingFlightAction === 'arm') {
                drones.forEach(drone => {
                    drone.armed = true;
                    drone.flightState = 'ARMED';
                });
            } else if (pendingFlightAction === 'takeoff') {
                const altitude = parseFloat(document.getElementById('takeoff-altitude-input').value);
                if (!Number.isFinite(altitude) || altitude <= 0 || altitude > 5000) {
                    showFlightActionError('Enter a takeoff altitude from 1 to 5000 metres.');
                    return;
                }
                const unarmed = drones.filter(drone => !drone.armed);
                if (unarmed.length > 0) {
                    showFlightActionError(`Arm these drones first: ${unarmed.map(drone => drone.id).join(', ')}`);
                    return;
                }
                drones.forEach(drone => {
                    if (drone.altitude <= 0.1 || !Number.isFinite(drone.launchLat) || !Number.isFinite(drone.launchLng)) {
                        drone.launchLat = drone.lat;
                        drone.launchLng = drone.lng;
                    }
                    drone.flightState = 'TAKING OFF';
                    drone.rtlAction = null;
                    drone.rthAction = null;
                    drone.verticalAction = { type: 'takeoff', targetAltitude: altitude, rateMps: 5 };
                });
            } else if (pendingFlightAction === 'land') {
                drones.forEach(drone => {
                    drone.missionQueue = [];
                    if (drone.mission) {
                        drone.mission.active = false;
                        drone.mission.paused = false;
                        drone.mission.stoppedByOperator = true;
                    }
                    drone.flightState = 'LANDING';
                    drone.rtlAction = null;
                    drone.rthAction = null;
                    drone.verticalAction = { type: 'land', targetAltitude: 0, rateMps: 4 };
                });
            } else if (pendingFlightAction === 'rtl') {
                const unarmed = drones.filter(drone => !drone.armed);
                if (unarmed.length > 0) {
                    showFlightActionError(`Arm these drones first: ${unarmed.map(drone => drone.id).join(', ')}`);
                    return;
                }
                drones.forEach(drone => {
                    drone.missionQueue = [];
                    if (drone.mission) {
                        drone.mission.active = false;
                        drone.mission.paused = false;
                        drone.mission.stoppedByOperator = true;
                    }
                    drone.verticalAction = null;
                    drone.rthAction = null;
                    drone.flightState = 'RETURNING TO LAUNCH';
                    drone.rtlAction = {
                        launchLat: Number.isFinite(drone.launchLat) ? drone.launchLat : BASE_LAT,
                        launchLng: Number.isFinite(drone.launchLng) ? drone.launchLng : BASE_LON,
                        velocityMps: Math.max(10, drone.velocity || 0)
                    };
                });
            } else if (pendingFlightAction === 'rth') {
                const takeoffAltitude = parseFloat(document.getElementById('takeoff-altitude-input').value);
                const returnVelocity = parseFloat(document.getElementById('flight-action-velocity-input').value);
                if (!Number.isFinite(takeoffAltitude) || takeoffAltitude <= 0 || takeoffAltitude > 5000) {
                    showFlightActionError('Enter a takeoff altitude from 1 to 5000 metres.');
                    return;
                }
                if (!Number.isFinite(returnVelocity) || returnVelocity <= 0 || returnVelocity > 500) {
                    showFlightActionError('Enter a return velocity from 1 to 500 m/s.');
                    return;
                }
                const armingTimeSec = Math.max(0.1, parseFloat(document.getElementById('mission-arming-time').value) || 5);
                const landingTimeSec = Math.max(0.1, parseFloat(document.getElementById('mission-landing-time').value) || 5);
                drones.forEach(drone => {
                    drone.missionQueue = [];
                    if (drone.mission) {
                        drone.mission.active = false;
                        drone.mission.paused = false;
                        drone.mission.stoppedByOperator = true;
                    }
                    drone.verticalAction = null;
                    drone.rtlAction = null;
                    const phase = !drone.armed
                        ? 'arming'
                        : drone.altitude < takeoffAltitude
                            ? 'takeoff'
                            : 'returning';
                    drone.flightState = phase === 'arming'
                        ? 'ARMING'
                        : phase === 'takeoff'
                            ? 'TAKING OFF'
                            : 'RETURNING HOME';
                    drone.velocity = returnVelocity;
                    drone.rthAction = {
                        phase: phase,
                        phaseElapsedSec: 0,
                        armingTimeSec: armingTimeSec,
                        takeoffAltitude: takeoffAltitude,
                        landingTimeSec: landingTimeSec,
                        landingStartAltitude: null,
                        homeLat: Number.isFinite(drone.homeLat) ? drone.homeLat : drone.lat,
                        homeLng: Number.isFinite(drone.homeLng) ? drone.homeLng : drone.lng,
