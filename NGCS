        function updateMissionRoleParameters(card) {
            const type = card.querySelector('.role-plan').value;
            card.querySelector('.mission-role-parameters').style.display = type ? 'grid' : 'none';
            if (!type) return;
            card.querySelectorAll('.role-target-coordinate').forEach(element => {
                element.style.display = type === 'waypoint' ? 'none' : 'flex';
            });
            ['goto', 'orbit', 'waypoint', 'survey'].forEach(parameterType => {
                card.querySelectorAll(`.role-${parameterType}`).forEach(element => {
                    element.style.display = parameterType === type
                        ? (element.tagName === 'LABEL' ? 'flex' : element.classList.contains('input-group') ? 'flex' : 'block')
                        : 'none';
                });
