            const numADR = parseInt(document.getElementById('adr-count-select').value) || 1;
            adrFleet = [];
            adrMarkers.clear();
            adrFovPolygons.clear();
            adrHeadingLines.clear();
            
            for (let i = 0; i < numADR; i++) {
                const standbyBearing = i * (360 / Math.max(numADR, 1));
                const initialPosition = getPointAtDistanceAndBearing(
                    BASE_LAT,
                    BASE_LON,
                    ADR_STANDBY_RADIUS_KM,
                    standbyBearing
                );
                const initDist = getDistanceKM(initialPosition.lat, initialPosition.lng, BASE_LAT, BASE_LON);
                
                adrFleet.push({ 
                    id: `ADR_BIRD_${i + 1}`, 
                    lat: initialPosition.lat,
                    lng: initialPosition.lng,
                    altitude: 350.0, 
                    velocity: Math.random() * (40 - 15) + 15,
                    heading: 0,
                    commandedHeading: 0,
                    rssi_dbm: -50.0 - 10 * 3.8 * Math.log10(Math.max(initDist, 0.1)),
                    state: 'STANDBY',
                    activeTargets: [],
                    supportedNodes: 0,
                    coverageAdequate: true
                });
            }
        }

        function generateSwarmArray() {
            selectedDrones.clear();
            const total = parseInt(document.getElementById('total-drones').value) || 30;
            
            dronesData = [];
            droneById.clear();
            droneLayer.clearLayers();
            droneMarkers = {};
            missionLayer.clearLayers();

            const numSwarms = Math.max(1, Math.floor(total / 5)); 
            const swarmCenters = [];
            for (let i = 0; i < numSwarms; i++) {
                swarmCenters.push({ lat: BASE_LAT + (Math.random() * 0.46 - 0.23), lng: BASE_LON + (Math.random() * 0.46 - 0.23) });
            }
            for (let i = 0; i < total; i++) {
                const center = swarmCenters[i % numSwarms];
                const initialLat = center.lat + (Math.random() * 0.03 - 0.015);
