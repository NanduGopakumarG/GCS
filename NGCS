    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        let BASE_LAT = 12.971599578857421875;
        let BASE_LON = 77.594596862792968750;
        
        const map = L.map('map', { 
            boxZoom: false,
            preferCanvas: true,
            attributionControl: false, 
            maxBounds: [[-90, -180], [90, 180]], 
            maxBoundsViscosity: 1.0, 
            minZoom: 2, 
            maxZoom: 19,
            dragging: false,
            zoomAnimation: false,
            fadeAnimation: false
        }).setView([BASE_LAT, BASE_LON], 10); 

        // Dense, frequently refreshed paths are much cheaper on one canvas than as
        // hundreds of individual SVG DOM nodes (especially on integrated GPUs).
        const overlayRenderer = L.canvas({ padding: 0.25, tolerance: 5 });
        
        // --- BASEMAP LAYERS (INCLUDING GOOGLE MAPS) ---
        const tileOptions = { noWrap: true, updateWhenIdle: true, keepBuffer: 1 };
        const defaultLayer = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
            ...tileOptions,
            maxZoom: 20,
            className: 'google-streets-dark'
        });
        const terrainLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', tileOptions);
        const satelliteLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', tileOptions);
        
        // Google Maps Tile URLs
        const googleStreets = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', { noWrap: true, maxZoom: 20 });
        const googleSatellite = L.tileLayer('https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}', { noWrap: true, maxZoom: 20 });
        const googleHybrid = L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', { noWrap: true, maxZoom: 20 });

        // Add default map initially
        defaultLayer.addTo(map);

        const baseMaps = {
            "Dark Theme (Default)": defaultLayer,
            "Google Hybrid (Realistic)": googleHybrid,
            "Google Satellite": googleSatellite,
            "Google Streets": googleStreets,
            "Esri Terrain": terrainLayer,
            "Esri Satellite": satelliteLayer
        };

        // UI Controls
        L.control.scale({ position: 'bottomleft', metric: true, imperial: true }).addTo(map);

        const zoomControl = L.control({ position: 'bottomleft' });
        zoomControl.onAdd = function (map) {
            this._div = L.DomUtil.create('div', 'zoom-indicator');
            this.update();
            return this._div;
        };
        zoomControl.update = function () {
            this._div.innerHTML = `Map Scale Factor: Zoom ${map.getZoom()}x`;
        };
        zoomControl.addTo(map);

        map.on('zoomend', function() {
            zoomControl.update();
        });

        // --- CUSTOM GCS RELOCATION CONTROL ---
        const gcsControl = L.control({ position: 'topright' });
        gcsControl.onAdd = function(map) {
            const btn = L.DomUtil.create('button', 'gcs-home-btn');
            btn.id = 'home-position-button';
            btn.title = 'Set GCS home location';
            btn.setAttribute('aria-label', 'Set GCS home location');
            
            // Using a clean inline SVG for the logo that adopts .gcs-home-icon color
            btn.innerHTML = `
                <svg class="gcs-home-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </svg>
            `;
            
            L.DomEvent.disableClickPropagation(btn);
            btn.onclick = openGcsPanel;
            return btn;
        };
        gcsControl.addTo(map);
        
        // --- MAP LAYER CONTROL (ADDED BELOW GCS BUTTON) ---
        L.control.layers(baseMaps, null, { position: 'topright' }).addTo(map);

        // Global mission playback controls, positioned below the layer selector.
        const missionPlaybackControl = L.control({ position: 'topright' });
        missionPlaybackControl.onAdd = function() {
            const container = L.DomUtil.create('div', 'mission-playback-control');
            container.innerHTML = `
                <button class="mission-playback-btn start" title="Start or resume all missions" aria-label="Start all missions">▶</button>
                <button class="mission-playback-btn pause" title="Pause all missions" aria-label="Pause all missions">Ⅱ</button>
                <button class="mission-playback-btn stop" title="Stop all missions" aria-label="Stop all missions">■</button>
            `;
            L.DomEvent.disableClickPropagation(container);
            L.DomEvent.disableScrollPropagation(container);
            container.querySelector('.start').addEventListener('click', startAllMissions);
            container.querySelector('.pause').addEventListener('click', pauseAllMissions);
            container.querySelector('.stop').addEventListener('click', stopAllMissions);
            return container;
        };
        missionPlaybackControl.addTo(map);

        const missionLauncherControl = L.control({ position: 'topright' });
        missionLauncherControl.onAdd = function() {
            const container = L.DomUtil.create('div', 'mission-launcher-control');
            container.innerHTML = `
                <button class="mission-playback-btn mission" title="Plan and assign a mission" aria-label="Plan mission">PLAN</button>
                <div class="mission-quick-menu">
                    <button data-mission-type="goto">📍 Go to Location</button>
                    <button data-mission-type="orbit">🔄 Orbit Location</button>
                    <button data-mission-type="waypoint">🛣️ Waypoint Path</button>
                    <button data-mission-type="survey">📐 Survey Area</button>
                </div>
            `;
            L.DomEvent.disableClickPropagation(container);
            L.DomEvent.disableScrollPropagation(container);
            container.querySelector('.mission').addEventListener('click', toggleMissionQuickMenu);
            container.querySelectorAll('[data-mission-type]').forEach(button => {
                button.addEventListener('click', () => beginMissionTargetSelection(button.dataset.missionType));
            });
            return container;
        };
        const flightModeControl = L.control({ position: 'topright' });
        flightModeControl.onAdd = function() {
            const button = L.DomUtil.create('button', 'flight-mode-switch');
            button.id = 'flight-mode-switch';
            button.innerText = 'FLY';
            button.title = 'Switch between ADR command and QGC-style Fly mode';
            L.DomEvent.disableClickPropagation(button);
            button.addEventListener('click', toggleFlightMode);
            return button;
        };
        flightModeControl.addTo(map);
        missionLauncherControl.addTo(map);

        const missionBuilderControl = L.control({ position: 'topright' });
        missionBuilderControl.onAdd = function() {
            const button = L.DomUtil.create('button', 'mission-builder-switch');
            button.id = 'mission-builder-switch';
            button.innerText = 'MISSION';
            button.title = 'Combine multiple plans into one mission';
            button.setAttribute('aria-label', 'Compose multi-plan mission');
            L.DomEvent.disableClickPropagation(button);
            button.addEventListener('click', openMissionBuilder);
            return button;
        };
        missionBuilderControl.addTo(map);



        const flyActionControl = L.control({ position: 'topright' });
        flyActionControl.onAdd = function() {
            const container = L.DomUtil.create('div', 'fly-action-control');
            container.innerHTML = `
                <button type="button" class="fly-action-btn arm" data-flight-action="arm">ARM</button>
                <button type="button" class="fly-action-btn takeoff" data-flight-action="takeoff">TAKEOFF</button>
                <button type="button" class="fly-action-btn land" data-flight-action="land">LAND</button>
                <button type="button" class="fly-action-btn rtl" data-flight-action="rtl" title="Return to launch and land">RTL</button>
                <button type="button" class="fly-action-btn rth" data-flight-action="rth" title="Return to assigned home, land, and disarm">RTH</button>
            `;
            L.DomEvent.disableClickPropagation(container);
            L.DomEvent.disableScrollPropagation(container);
            container.querySelectorAll('[data-flight-action]').forEach(button => {
                button.addEventListener('click', () => openFlightActionPanel(button.dataset.flightAction));
            });
            return container;
        };
        flyActionControl.addTo(map);

        const flyFleetControl = L.control({ position: 'topleft' });
        flyFleetControl.onAdd = function() {
            const container = L.DomUtil.create('div', 'fly-fleet-control');
            container.innerHTML = `
                <label for="fly-drone-count">FLY SIMULATION DRONES</label>
                <div class="fly-fleet-row">
                    <input type="number" id="fly-drone-count" value="1" min="1" max="500" step="1">
                    <button type="button" id="apply-fly-fleet">APPLY</button>
                </div>
                <label class="fly-swarm-option">
                    <input type="checkbox" id="fly-swarm-enabled">
                    <span>Enable Swarm</span>
                </label>
                <label for="fly-airframe-select" style="display: block; margin-top: 8px;">AIRFRAME TYPE</label>
                <select id="fly-airframe-select" style="cursor: pointer; width: 100%; padding: 5px; box-sizing: border-box;">
                    <option value="multirotor">Multirotor</option>
                    <option value="vtol">VTOL</option>
                    <option value="fixed-wing">Fixed-Wing</option>
