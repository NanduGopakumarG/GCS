                        iconSize: [0, 0]
                    })
                }).addTo(map);
                insertMarker.on('click', function(e) {
                    if (e.originalEvent) L.DomEvent.stopPropagation(e.originalEvent);
                    waypointPlan.splice(segmentIndex + 1, 0, { lat: midpoint.lat, lng: midpoint.lng });
                    renderWaypointPreview();
                });
                waypointInsertMarkers.push(insertMarker);
            }
            renderSurveyCoveragePreview();
        }

